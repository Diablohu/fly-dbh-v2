---
import { type ChallengeDifficultyType } from "@/types";

type Props = {
    href?: string;
    prefix?: string;
    difficultyColor?: ChallengeDifficultyType;
} & astroHTML.JSX.AnchorHTMLAttributes &
    astroHTML.JSX.ButtonHTMLAttributes;

const {
    class: className,
    href,
    prefix,
    difficultyColor,
    ...props
} = Astro.props;

const Element = Astro.props.href ? "a" : "button";
---

<Element
    class:list={["tag", className]}
    href={Element === "a" ? href : null}
    type={Element === "button" ? "button" : null}
    data-difficulty={difficultyColor || null}
    {...props}
    >{
        Astro.slots.has("prefix") ? (
            <span class="prefix">
                <slot name="prefix" />
            </span>
        ) : (
            prefix && <span class="prefix">{prefix}</span>
        )
    }<slot /></Element
>

<style lang="less">
    @import "./tag-button.module.less";
</style>

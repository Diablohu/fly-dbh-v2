---
import AdminPage from "@/page-templates/admin/index.astro";

type ItemType = {
    name: string;
    url: string;
};
const list: [string, ItemType[]][] = [];
const listByCategory: Record<string, ItemType[]> = {};
Object.keys(import.meta.glob("./**/!(_*).astro")).forEach((pathname) => {
    const filename = pathname.replace(/^\.\//, "");
    const [category, ...rest] = filename.split("/");
    const name = rest.join("/").replace(/\.astro$/, "");
    const url = `${Astro.originPathname}/${category}/${name}`;

    if (!listByCategory[category]) {
        const thisList: ItemType[] = [];
        listByCategory[category] = thisList;
        list.push([category, thisList]);
    }
    listByCategory[category].push({ name, url });
});
---

<AdminPage title="信息图表">
    {
        list.map(([title, list]) => (
            <dl>
                <dt>{title.toUpperCase()}</dt>
                {list.map((item) => (
                    <dd>
                        <a class="link" href={item.url}>
                            {item.name}
                        </a>
                    </dd>
                ))}
            </dl>
        ))
    }
</AdminPage>

<style lang="less">
    @import "@/utils/mixins.less";

    dl {
        dt {
            color: var(--text-color-primary);
            font-weight: bold;
        }
    }
</style>

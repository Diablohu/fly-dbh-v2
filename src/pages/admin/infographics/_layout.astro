---
import AdminPage from "@/layouts/pages/admin/index.astro";

import Controls from "./_controls";
---

<AdminPage
    title="📊"
    showTitle={false}
    layout={{
        header: false,
        footer: false,
        sideBar: false,
    }}
>
    <section class="body">
        <Controls client:only />
        <article class="content"><slot /></article>
    </section>
</AdminPage>

<style lang="less">
    @import "@/utils/mixins.less";

    .body {
        --text-color-primary: var(--dark-text-color-primary);
        --text-color-secondary: var(--dark-text-color-secondary);
        --global-header-background-color: var(--dark-theme-color-p-70);

        position: fixed;
        top: 0;
        right: 0;
        width: 100%;
        height: 100%;

        color: #fff;
        background-color: #000;
        font-family:
            Roboto, "SF Pro Display", "SF Pro Icons", "Helvetica Neue",
            Helvetica, Arial, "Sarasa Gothic SC", "更纱黑体",
            "Microsoft YaHei UI", "Microsoft YaHei", "Hiragino Sans GB",
            sans-serif;

        display: flex;
        flex-flow: row nowrap;
        justify-content: stretch;
        align-items: stretch;
    }
    .content {
        position: relative;
        z-index: 5;
        flex: 1;
    }
</style>

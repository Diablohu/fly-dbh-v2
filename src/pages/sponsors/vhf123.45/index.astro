<style lang="less">
    @import "@/utils/mixins.less";

    section.banner {
        --banner-min-height: 300px;
        --banner-height: 50vh;
        --banner-expanded-height: 10em;
        --title-font-size: unit(
            (2.5 * @base-font-size-number-h1 / @base-font-size-number),
            em
        );

        position: relative;
        z-index: 1;
        background: no-repeat 77.5% 30% / cover;
        height: calc(var(--banner-height) + var(--banner-expanded-height));
        min-height: var(--banner-min-height);
        margin-top: calc(var(--global-header-height) * -1);
        margin-bottom: calc(var(--banner-expanded-height) * -1);
        padding-top: var(--global-header-height);

        .screen-sm({
            --banner-min-height: 250px;
            --banner-height: 40vh;
            --title-font-size: unit(
                (1.75 * @base-font-size-number-h1 / @base-font-size-number),
                em
            );
        });

        .content {
            position: absolute;
            z-index: 3;
            bottom: var(--banner-expanded-height);
            color: var(--dark-text-color-primary);
            // font-weight: 900;
            text-shadow: 0 0.1em 0.15em var(--dark-theme-color-p-80);
            padding-bottom: 2em;
            h2 {
                color: inherit;
                font-size: var(--title-font-size);
                font-family: var(--font-fbw-display-eis-a380-slashed-zero);
                // font-style: italic;
                .vhf {
                    //     font-family: var(--font-fbw-display-eis-a380-slashed-zero);
                    letter-spacing: 0.1em;
                }
                .numeral {
                    padding-left: 0.25em;
                    //     font-family: var(--font-airbus-rtpi);
                    //     font-size: 1.1em;
                }
            }
            // &::after {
            //     position: absolute;
            //     content: "";
            //     width: 100%;
            //     height: 100%;
            //     bottom: 0;
            //     left: 0;
            //     @supports (mask-image: linear-gradient(black, transparent)) {
            //         z-index: 2;
            //         mask-image: linear-gradient(
            //             to right,
            //             black 0,
            //             transparent 100%
            //         );
            //         backdrop-filter: blur(var(--backdrop-filter-blur-value));
            //     }
            // }
        }

        // img.cover {
        //     position: absolute;
        //     z-index: 1;
        //     display: block;
        //     width: 100%;
        //     height: 100%;
        //     bottom: 0;
        //     left: 0;
        //     object-fit: cover;
        // }

        .mask {
            &,
            &::before,
            &::after {
                content: "";
                position: absolute;
                width: 100%;
                bottom: 0;
                left: 0;
            }

            z-index: 2;
            height: 100%;
            display: block;
            background: linear-gradient(
                60deg,
                var(--dark-theme-color-p-30) 33.3333%,
                var(--dark-theme-color-p-20) 50%,
                var(--dark-theme-color-p-0) 100%
            );

            &::before {
                z-index: 2;
                height: 100%;
                .pixel-dots-styles();
            }
            &::after {
                z-index: 3;
                height: calc(var(--banner-expanded-height) * 2);
                background: linear-gradient(
                    to bottom,
                    var(--theme-color-p-0) 0%,
                    var(--theme-color-p-80) 60%,
                    var(--theme-color) 100%
                );
            }
        }
    }

    section.article {
        position: relative;
        z-index: 2;
    }
</style>

---
import { actions, ActionError } from "astro:actions";

import { type ValidContentListAutoLoadMoreType } from "@/types";
import { CONTENT_LIST_AUTO_LOAD_MORE } from "@/constants/cookies";
import { errorLog } from "@/utils/log";

import Layout from "@/layouts/layout.astro";
import Block from "@/components/block.astro";

import FormAndResult from "./_form-and-result";

if (Astro.params.keyword) {
}
const { data: initialResults, error } = !Astro.params.keyword
    ? {}
    : await Astro.callAction(actions.search.query, {
          keyword: Astro.params.keyword,
      });
if (error) {
    const err = error as unknown as ActionError;
    errorLog(
        [
            `${Astro.originPathname} -> 500`,
            err.code,
            err.message,
            (err.cause as any)?.GROQ
                ? `GROQ: "${(err.cause as any)?.GROQ.replace(/\n\s+/gm, " ")}"`
                : "",
        ]
            .filter(Boolean)
            .join(" | ")
    );
    Astro.response.status = 500;
    Astro.props.error = error;
    return Astro.rewrite("/500");
}
---

<Layout
    title={`搜索${Astro.params.keyword ? `: ${Astro.params.keyword}` : ""}`}
    header
    footer
>
    <Block>
        <FormAndResult
            client:idle
            initialKeyword={Astro.params.keyword || ""}
            initialResults={initialResults}
            defaultContentListAutoLoadMore={Astro.cookies.get(
                CONTENT_LIST_AUTO_LOAD_MORE
            )?.value as ValidContentListAutoLoadMoreType}
        />
    </Block>
</Layout>

<style lang="less">
    @import "@/utils/mixins.less";

    h2 {
        zoom: 1;
    }
</style>

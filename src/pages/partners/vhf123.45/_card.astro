---
import getSanityImageUrl from "@/utils/get-sanity-image-url";

import Markdown from "@/components/markdown.astro";
import { generateHtmlImageViewer } from "@/utils/image-viewer";

// ============================================================================

type Props = {
    title: string;
    description: string;
    remarks?: string[];
    sanityImageFilename: string;
};
---

<div class="card">
    <Fragment
        set:html={generateHtmlImageViewer({
            containerClass: "image",
            src: getSanityImageUrl(Astro.props.sanityImageFilename, {
                format: "webp",
                width: 640,
                quality: 60,
            }),
            srcOriginal: getSanityImageUrl(Astro.props.sanityImageFilename, {
                format: "webp",
                quality: 80,
            }),
            alt: Astro.props.title,
        })}
    />
    <div class="content">
        <h3>{Astro.props.title}</h3>
        <div class="description">
            <Markdown src={Astro.props.description} />
        </div>
        {
            Array.isArray(Astro.props.remarks) &&
                Astro.props.remarks.length > 0 && (
                    <ul class="remarks">
                        {Astro.props.remarks.map((remark) => (
                            <li>{remark}</li>
                        ))}
                    </ul>
                )
        }
    </div>
</div>

<style lang="less">
    @import "@/utils/mixins.less";

    .card {
        position: relative;
        overflow: hidden;
        padding: 0.5em;

        &::after {
            content: "";
            position: absolute;
            z-index: -1;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: var(--tag-background-color);
            border: 1px solid var(--tag-border-color);
            border-radius: 10px;
            @supports (mask-image: linear-gradient(black, transparent)) {
                mask-image: linear-gradient(
                    to bottom,
                    black 50%,
                    transparent 100%
                );
            }
        }

        & > :global(.image) {
            display: block;
            position: relative;
            width: 100%;
            height: 0;
            padding-bottom: percentage((5 / 11));
            overflow: hidden;
            border-radius: 8px;
            :global(img) {
                display: block;
                position: absolute;
                width: 100%;
                height: 100%;
                object-fit: cover;
            }
        }
        .content {
            padding: 0 0.6667em;

            & > h3,
            & > .description {
                color: var(--text-color-primary);
                zoom: 1.1;
                :global(a) {
                    color: inherit;
                }
            }
            & > h3 {
                margin-top: 0.6667em;
                margin-bottom: -0.13333em;
            }
            .remarks {
                margin: 0 0 0.5em 0;
                padding: 0 0 0 1em;
                & > li {
                    margin: 0;
                    // padding: 0;
                    list-style: "* ";
                }
            }
        }
    }
</style>

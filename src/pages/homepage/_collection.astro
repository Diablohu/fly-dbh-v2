---
import { actions } from "astro:actions";
import { type ValueOf } from "@/types";
import VideoListHorizontal from "@/components/video-list-horizontal.tsx";
import getVideoItemTopTags from "@/utils/get-video-item-top-tags";
import getVideoListPageLink from "@/utils/get-video-list-page-link";

type Props = {
    name: string;
    route?: string;
    link?: string;
    title: string;
    videos?: ValueOf<
        Exclude<
            Awaited<ReturnType<typeof actions.homePage.fetch>>["data"],
            undefined
        >
    >;
    showMore?: boolean | string;
    titleMore?: boolean;
    backgroundColor?: "teal" | "red";
    allowAssetPriorityHigh?: boolean;
} & astroHTML.JSX.DefinedIntrinsicElements["dl"];
const {
    class: className,
    name,
    route,
    link,
    title,
    videos,
    showMore = true,
    titleMore = true,
    backgroundColor,
    allowAssetPriorityHigh,
    ...props
} = Astro.props;

const moreLink =
    link ??
    (route?.[0] === "/"
        ? route
        : `${getVideoListPageLink()}${route ? `/${route}` : ""}`);
---

<dl
    class:list={[
        "collection",
        className,
        {
            "mod-highlight": Boolean(backgroundColor),
            [`mod-highlight-${backgroundColor}`]: Boolean(backgroundColor),
        },
    ]}
    data-collection={name}
    {...props}
>
    <dt class="collection-title">
        <h3>
            {titleMore ? <a href={moreLink}>{title}</a> : title}
        </h3>
        {
            showMore && (
                <span class="link-more">
                    <a href={moreLink}>
                        {showMore === true ? "更多" : showMore}
                    </a>
                </span>
            )
        }
    </dt>
    <dd class="collection-list">
        {
            !videos || !Array.isArray(videos) || videos.length < 1 ? (
                <slot />
            ) : (
                <VideoListHorizontal
                    client:idle
                    videos={videos.map((post) => ({
                        _id: post._id,
                        slug: post.slug,
                        title: post.title,
                        cover: post.cover,
                        duration: post.duration,
                        links: post.links,
                        infos: [
                            [
                                ...(getVideoItemTopTags(
                                    post,
                                    name === "tutorials"
                                        ? "tutorial"
                                        : name === "reviews"
                                          ? "review"
                                          : (name as Parameters<
                                                typeof getVideoItemTopTags
                                            >[1]),
                                ) || []),
                                new Date(post.release),
                            ].filter(Boolean),
                        ],
                    }))}
                    allowAssetPriorityHigh={allowAssetPriorityHigh}
                />
            )
        }
    </dd>
    <slot name="extra" />
</dl>

<style lang="less">
    @import "@/utils/mixins.less";

    .collection {
        --margin-bottom: var(--homepage-collection-gap);
        // --title-link-more-opacity: unset;
        --title-link-more-transform: unset;

        display: block;
        position: relative;
        margin-top: 0;
        margin-bottom: var(--margin-bottom);

        &:has(+ .collection:not(.mod-highlight)) {
            &::after {
                content: "";
                position: absolute;
                bottom: calc(var(--margin-bottom) / -2);
                height: var(--homepage-collection-divider-height);
                left: 0;
                right: 0;
                background: var(--homepage-collection-divider-color);
            }
        }

        & > .collection-title,
        & > .collection-list {
            position: relative;
            padding: 0;
            z-index: 5;
        }
        & > .collection-title {
            display: flex;
            flex-flow: row nowrap;
            justify-content: space-between;
            align-items: flex-end;
            margin: 0 0 1em 0;
            & > h3 {
                display: block;
                flex: 1;
                margin: 0;
                font-size: 1.25em;
            }
            a {
                .link-with-arrow-styles();
            }
            & > .link-more {
                // transition: opacity var(--base-transition-duration);
                // opacity: var(--title-link-more-opacity);
                transition: transform var(--base-transition-duration);
                transform: var(--title-link-more-transform);
                a {
                    white-space: nowrap;
                    color: var(--text-color-secondary);
                    &:hover {
                        color: var(--text-color-primary);
                    }
                }
            }
        }
        & > .collection-list {
            margin: 0;
        }
    }

    .collection:has(+ .mod-highlight) {
        margin-bottom: calc(var(--margin-bottom) / 1.5);
        // &::after {
        //     display: none;
        // }
    }

    .collection.mod-highlight {
        --challenge-item-background-color: var(--theme-color-p-80);

        padding: 1.5em var(--global-edge-safe-distance) 1.75em
            var(--global-edge-safe-distance);
        margin-left: calc(var(--global-edge-safe-distance) * -1);
        margin-right: calc(var(--global-edge-safe-distance) * -1);
        margin-bottom: calc(var(--margin-bottom) / 1.75);
        &::after {
            display: none;
        }
        &::before {
            content: "";
            position: absolute;
            top: 0;
            bottom: 0;
            left: 0;
            right: 0;
            z-index: -1;
            background: var(--collection-background-color);
            border-radius: 1em;
        }
        @media screen and (max-width: 1676px) {
            overflow: hidden;
            &:before {
                left: 50%;
                right: auto;
                width: 100vw;
                width: 100dvw;
                margin-left: -50vw;
                margin-left: -50dvw;
                border-radius: 0;
            }
        }
        // .screen-lg-below({
        //     border-radius: 0;
        // });
        &.mod-highlight-teal {
            --collection-background-color: var(
                --menu-background-color-highlight
            );
            --collection-background-color: color-mix(
                in hsl,
                var(--theme-color),
                var(--accent-color-teal) 25%
            );
        }
        &.mod-highlight-red {
            --collection-background-color: var(
                --menu-background-color-highlight
            );
            --collection-background-color: color-mix(
                in hsl,
                var(--theme-color),
                var(--accent-color-red) 20%
            );
            // box-shadow: inset 0 0 20em 10em var(--collection-background-color);
        }

        &:has(+ .collection.mod-highlight) {
            margin-bottom: 2px;
            &::before {
                border-bottom-left-radius: 0;
                border-bottom-right-radius: 0;
            }
            & + .collection.mod-highlight {
                &::before {
                    border-top-left-radius: 0;
                    border-top-right-radius: 0;
                }
            }
        }
    }

    :global(:root.root-is-home-banner-visible)
        .collection[data-collection="latest"] {
        // --title-link-more-opacity: 0;
        --title-link-more-transform: translateX(-6em);
    }
</style>

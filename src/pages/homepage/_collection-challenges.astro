---
import { type ComponentProps } from "react";
import { type HomeCollectionsType } from "@/types";

import Collection from "./_collection.astro";
import ChallengeListHorizontal from "@/components/challenge-list-horizontal";

import { routeBase } from "@/global";

type Props = {
    list: HomeCollectionsType["challenges"];
    title?: string;
    route?: string;
} & Pick<ComponentProps<typeof Collection>, "showMore" | "titleMore">;

// console.log(Astro.props.list)
---

<Collection
    name="latest-challenges"
    title={Astro.props.title ?? "最新收录着陆挑战"}
    route={Astro.props.route ?? routeBase.challenges}
    showMore={Astro.props.showMore}
    titleMore={Astro.props.titleMore}
>
    <ChallengeListHorizontal
        client:idle
        challenges={Astro.props.list}
        showAircraftTypes
    />
    <!-- <section class="challenges">
        {Astro.props.list.map((item) => <ChallengeItem item={item} />)}
    </section> -->
</Collection>

<style lang="less">
    @import "@/utils/mixins.less";

    .challenges {
        display: flex;
        flex-flow: row nowrap;
        gap: 1em;
        margin: 0;
        padding: 0 0 1em 0;
        overflow: hidden;
        overflow-x: auto;
        scrollbar-width: none;
        scroll-snap-type: x mandatory;
        & > :global(*) {
            flex: 1 0 var(--challenge-list-item-min-width);
            scroll-snap-align: start;
        }
    }
</style>

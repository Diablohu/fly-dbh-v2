---
import { actions } from "astro:actions";
import { type ValueOf } from "@/types";
import VideoListHorizontal from "@/components/video-list-horizontal.tsx";
import getVideoItemTopTags from "@/utils/get-video-item-top-tags";
import getVideoListPageLink from "@/utils/get-video-list-page-link";

type Props = {
    name: string;
    route?: string;
    link?: string;
    title: string;
    videos?: ValueOf<
        Exclude<
            Awaited<ReturnType<typeof actions.homePage.fetch>>["data"],
            undefined
        >
    >;
    showMore?: boolean;
    highlighted?: boolean;
};
const { showMore = true } = Astro.props;
const moreLink =
    Astro.props.link ??
    (Astro.props.route?.[0] === "/"
        ? Astro.props.route
        : `${getVideoListPageLink()}${Astro.props.route ? `/${Astro.props.route}` : ""}`);
---

<dl
    class:list={[
        "collection",
        {
            "mod-highlight": Astro.props.highlighted,
        },
    ]}
    data-collection={Astro.props.name}
>
    <dt class="collection-title">
        <h3>
            <a href={moreLink}>
                {Astro.props.title}
            </a>
        </h3>
        {
            showMore && (
                <span class="link-more">
                    <a href={moreLink}>更多</a>
                </span>
            )
        }
    </dt>
    <dd class="collection-list">
        {
            !Astro.props.videos ||
            !Array.isArray(Astro.props.videos) ||
            Astro.props.videos.length < 1 ? (
                <slot />
            ) : (
                <VideoListHorizontal
                    client:idle
                    videos={Astro.props.videos.map((post) => ({
                        _id: post._id,
                        slug: post.slug,
                        title: post.title,
                        cover: post.cover,
                        duration: post.duration,
                        links: post.links,
                        infos: [
                            [
                                ...(getVideoItemTopTags(
                                    post,
                                    Astro.props.name === "tutorials"
                                        ? "tutorial"
                                        : Astro.props.name === "reviews"
                                          ? "review"
                                          : (Astro.props.name as Parameters<
                                                typeof getVideoItemTopTags
                                            >[1])
                                ) || []),
                                new Date(post.release),
                            ].filter(Boolean),
                        ],
                    }))}
                />
            )
        }
    </dd>
    <slot name="extra" />
</dl>

<style lang="less">
    @import "@/utils/mixins.less";

    .collection {
        --margin-bottom: 5em;
        // --title-link-more-opacity: unset;
        --title-link-more-transform: unset;

        display: block;
        position: relative;
        margin-top: 0;
        margin-bottom: var(--margin-bottom);

        &::after {
            content: "";
            position: absolute;
            bottom: calc(var(--margin-bottom) / -2);
            height: 1px;
            left: 0;
            right: 0;
            background: var(--border-color);
        }

        & > .collection-title,
        & > .collection-list {
            position: relative;
            padding: 0;
            z-index: 5;
        }
        & > .collection-title {
            display: flex;
            flex-flow: row nowrap;
            justify-content: space-between;
            align-items: flex-end;
            margin: 0 0 1em 0;
            & > h3 {
                display: block;
                flex: 1;
                margin: 0;
                font-size: 1.25em;
            }
            a {
                .link-with-arrow-styles();
            }
            & > .link-more {
                // transition: opacity var(--base-transition-duration);
                // opacity: var(--title-link-more-opacity);
                transition: transform var(--base-transition-duration);
                transform: var(--title-link-more-transform);
                a {
                    white-space: nowrap;
                    color: var(--text-color-secondary);
                    &:hover {
                        color: var(--text-color-primary);
                    }
                }
            }
        }
        & > .collection-list {
            margin: 0;
        }
    }

    .collection:has(+ .mod-highlight) {
        margin-bottom: calc(var(--margin-bottom) / 1.5);
        &::after {
            display: none;
        }
    }

    .collection.mod-highlight {
        --collection-background-color: var(--menu-background-color-highlight);
        --collection-background-color: color-mix(
            in hsl,
            var(--theme-color),
            var(--accent-color-teal) 25%
        );

        background: var(--collection-background-color);
        padding: 1.5em var(--global-edge-safe-distance) 1.75em
            var(--global-edge-safe-distance);
        border-radius: 10px;
        margin-left: calc(var(--global-edge-safe-distance) * -1);
        margin-right: calc(var(--global-edge-safe-distance) * -1);
        margin-bottom: calc(var(--margin-bottom) / 1.25);
        &::after {
            display: none;
        }
        // &::before {
        //     content: "";
        //     position: absolute;
        //     top: 0;
        //     bottom: 0;
        //     left: 0;
        //     right: 0;
        //     z-index: -1;
        //     background: var(--accent-color-teal);
        //     border-radius: inherit;
        //     opacity: 0.1;
        // }
        .screen-lg-below({
            border-radius: 0;
        });
    }

    :global(:root.root-is-home-banner-visible)
        .collection[data-collection="latest"] {
        // --title-link-more-opacity: 0;
        --title-link-more-transform: translateX(-6em);
    }
</style>

---
import { actions, ActionError } from "astro:actions";

import Layout from "@/layouts/layout.astro";
import Block from "@/components/block.astro";
import HeroImage from "@/components/hero-image";

import List from "../challenges/_components/list";

import { errorLog } from "@/utils/log";

// ============================================================================

const { data: list, error } = await Astro.callAction(
    actions.challengePage.fetchListAll,
    undefined
);
if ((error && error.code === "NOT_FOUND") || !list) {
    if (error)
        errorLog(
            [
                `${Astro.originPathname} -> 404`,
                error.code,
                error.message,
                (error.cause as any)?.GROQ
                    ? `GROQ: "${(error.cause as any)?.GROQ.replace(/\n\s+/gm, " ")}"`
                    : "",
            ]
                .filter(Boolean)
                .join(" | ")
        );
    else
        errorLog(
            [`${Astro.originPathname} -> 404`, "No challenge list"]
                .filter(Boolean)
                .join(" | ")
        );
    return Astro.rewrite("/404");
}
if (error) {
    const err = error as unknown as ActionError;
    errorLog(
        [
            `${Astro.originPathname} -> 500`,
            err.code,
            err.message,
            (err.cause as any)?.GROQ
                ? `GROQ: "${(err.cause as any)?.GROQ.replace(/\n\s+/gm, " ")}"`
                : "",
        ]
            .filter(Boolean)
            .join(" | ")
    );
    Astro.response.status = 500;
    Astro.props.error = error;
    return Astro.rewrite("/500");
}

// ============================================================================


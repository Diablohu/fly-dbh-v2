<style lang="less">
    @import "@/utils/mixins.less";

    .list {
        --container-top-edge: 0.5em;
        margin-top: 1em;
    }

    .sticky-actions {
        position: sticky;
        top: calc(
            var(--global-sticky-top) //  + var(--hero-image-stiky-height)
            + var(--container-top-edge) + 0.5em
        );
        left: 0;
        z-index: calc(var(--hero-image-z-index) + 1);
        margin-top: -4.2em;
        margin-bottom: 4.2em;
        height: 0;
        display: flex;
        flex-flow: row nowrap;
        justify-content: flex-end;
        display: none;
        button {
            .tag-styles();
            display: block;
            height: 2em;
        }
    }

    .actions {
        margin-top: 2em;
        margin-bottom: 4em;
        text-align: center;
    }
</style>

---

<Layout title="着陆挑战名册" header footer>
    <HeroImage
        client:idle
        title="着陆挑战名册（开发中）"
        sanityImageFilename="5a99e9237a5a459b5b14f9d30c999e38150359af-2560x1440.png"
        sticky={false}
    />

    <Block class="list">
        <section class="sticky-actions">
            <button type="button">过滤</button>
            <button type="button">抽选</button>
            <button type="button">提议</button>
        </section>
        <List list={list} client:idle />

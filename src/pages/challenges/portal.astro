---
/*
Remember Options
DEFAULTS
    Categories: C+D
    Difficulty: 3+5+7
Trigger: COOKIE - RANDOM or CATALOG
*/

import { actions, ActionError } from "astro:actions";

import { urlPrefixSanityImageCdn, getChallengeCatalogPageLink } from "@/global";
import Layout from "@/layouts/layout.astro";
import Block from "@/components/block.astro";
import HomeCollectionChallenges from "@/pages/homepage/collection-challenges.astro";

import { errorLog } from "@/utils/log";

// ============================================================================

const { data: latest, error } = await Astro.callAction(
    actions.challengePage.fetchList,
    { length: 10, sort: "latest" },
);
if ((error && error.code === "NOT_FOUND") || !latest) {
    if (error)
        errorLog(
            [
                `${Astro.originPathname} -> 404`,
                error.code,
                error.message,
                (error.cause as any)?.GROQ
                    ? `GROQ: "${(error.cause as any)?.GROQ.replace(/\n\s+/gm, " ")}"`
                    : "",
            ]
                .filter(Boolean)
                .join(" | "),
        );
    else
        errorLog(
            [`${Astro.originPathname} -> 404`, "No challenge list"]
                .filter(Boolean)
                .join(" | "),
        );
    return Astro.rewrite("/404");
}
if (error) {
    const err = error as unknown as ActionError;
    errorLog(
        [
            `${Astro.originPathname} -> 500`,
            err.code,
            err.message,
            (err.cause as any)?.GROQ
                ? `GROQ: "${(err.cause as any)?.GROQ.replace(/\n\s+/gm, " ")}"`
                : "",
        ]
            .filter(Boolean)
            .join(" | "),
    );
    Astro.response.status = 500;
    Astro.props.error = error;
    return Astro.rewrite("/500");
}

// ============================================================================

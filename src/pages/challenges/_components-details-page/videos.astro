---
import { type ChallengeItemType } from "@/types";

import InfoBlock from "./_info-block.astro";
import VideoListGrid from "@/components/video-list-grid";

type Props = {
    list: ChallengeItemType["videos_this_aerodrome"];
} & astroHTML.JSX.HTMLAttributes;

const { list, ...props } = Astro.props;
// TODO: change to horizontal list
// TODO: more videos link on title
---

{
    Array.isArray(list) && list.length > 0 && (
        <InfoBlock {...props} title="本机场的相关视频">
            <VideoListGrid
                type="search"
                isIndex
                initialList={list}
                initialListIsComplete
                showLoadMoreButton={false}
            />
        </InfoBlock>
    )
}

<style lang="less">
    @import "../_mixins.less";

    .list {
        .challenge-list-styles();
    }
</style>

---
import { type ChallengeItemType } from "@/types";

import {
    challengeDifficultyString,
    aircraftCategoryTypeString,
} from "@/global";

import InfoBlock from "./_info-block.astro";

import parseMarkdown from "@/utils/parse-markdown";

type Props = {
    difficulty: ChallengeItemType["difficulty"];
    maxCategory: ChallengeItemType["max_allowed_aircraft_category"];
    typicalAircrafts: ChallengeItemType["typical_aircrafts"];
} & astroHTML.JSX.HTMLAttributes;

const { difficulty, maxCategory, typicalAircrafts, ...props } = Astro.props;
/*
A：＜ 91
B：91 ~ 120
C：121 ~ 140
D：141 ~ 165
E：166 ~ 210
*/
---

<InfoBlock {...props} title="挑战信息" emoji="🛩️">
    <dl>
        <dt>难度级别</dt>
        <dd data-difficulty={difficulty}>
            {challengeDifficultyString[difficulty]}
        </dd>
    </dl>
    <dl>
        <dt>最大允许</dt>
        <dd>
            {maxCategory.toUpperCase()} 类飞机：{
                aircraftCategoryTypeString[maxCategory]
            }
        </dd>
    </dl>
    <dl>
        <dt>当地常客</dt>
        <dd set:html={parseMarkdown(typicalAircrafts)} />
    </dl>
</InfoBlock>

<style lang="less">
    @import "@/utils/mixins.less";

    dl {
        display: block;
        margin: 0;
        position: relative;
        padding-left: 4.75em;
        dt {
            position: absolute;
            top: 0;
            left: 0;
            color: var(--text-color-secondary);
        }
        dd {
            margin: 0;
            :global(p, ul) {
                margin: 0;
            }
            :global(ul) {
                padding-left: 2em;
            }
            &[data-difficulty] {
                color: var(--difficulty-color);
                padding-left: 1.5em;
                position: relative;
                &::before {
                    content: var(--difficulty-emoji);
                    display: inline-block;
                    font-style: normal;
                    position: absolute;
                    top: 0;
                    left: 0;
                }
            }
            &[data-difficulty="1"] {
                --difficulty-color: var(--difficulty-color-1);
                --difficulty-emoji: var(--difficulty-emoji-1);
            }
            &[data-difficulty="3"] {
                --difficulty-color: var(--difficulty-color-3);
                --difficulty-emoji: var(--difficulty-emoji-3);
            }
            &[data-difficulty="5"] {
                --difficulty-color: var(--difficulty-color-5);
                --difficulty-emoji: var(--difficulty-emoji-5);
            }
        }
    }
</style>

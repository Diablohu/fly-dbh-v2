---
import { type ChallengeItemType } from "@/types";

import {
    challengeDifficultyString,
    aircraftCategoryTypeString,
    aircraftTypeString,
} from "@/global";

import InfoBlock from "./_info-block.astro";
import Markdown from "@/components/markdown.astro";

type Props = {
    difficulty: ChallengeItemType["difficulty"];
    maxCategory: ChallengeItemType["max_allowed_aircraft_category"];
    typicalAircrafts: ChallengeItemType["typical_aircrafts"];
    typicalAircraftTypes: ChallengeItemType["typical_aircraft_types"];
} & astroHTML.JSX.HTMLAttributes;

const {
    difficulty,
    maxCategory,
    typicalAircrafts,
    typicalAircraftTypes,
    ...props
} = Astro.props;
/*
A：＜ 91
B：91 ~ 120
C：121 ~ 140
D：141 ~ 165
E：166 ~ 210
*/
---

<InfoBlock {...props} title="挑战信息" emoji="🛩️">
    <dl>
        <dt>难度级别</dt>
        <dd data-difficulty={difficulty}>
            {challengeDifficultyString[difficulty]}
        </dd>
    </dl>
    <dl>
        <dt>最大允许</dt>
        <dd>
            {maxCategory.toUpperCase()} 类飞机（进近速度分类）
        </dd>
    </dl>
    <dl>
        <dt>适合机型</dt>
        <dd>
            {
                typicalAircraftTypes
                    .map((type) => aircraftTypeString[type])
                    .join("、")
            }
        </dd>
    </dl>
    <dl>
        <dt>当地常客</dt>
        <dd>
            <Markdown src={typicalAircrafts} />
        </dd>
    </dl>
</InfoBlock>

<style lang="less">
    @import "@/utils/mixins.less";

    dl {
        --dl-padding-left: 4.75em;
        display: block;
        margin: 0;
        position: relative;
        dt {
            position: absolute;
            top: 0;
            left: 0;
            color: var(--text-color-secondary);
        }
        dd {
            .difficulty-variables();
            &[data-difficulty] {
                color: var(--difficulty-color);
                padding-left: 1.5em;
                position: relative;
                &::before {
                    content: var(--difficulty-icon);
                    display: inline-block;
                    font-style: normal;
                    position: absolute;
                    top: 0;
                    left: 0;
                }
            }
        }
    }
</style>

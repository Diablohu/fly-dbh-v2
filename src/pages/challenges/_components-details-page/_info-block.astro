---
type Props = {
    title: string;
    titleLink?: string;
    emoji?: string;
    isTodo?: boolean;
    bodyClass?: string;
} & astroHTML.JSX.HTMLAttributes;

const {
    title,
    titleLink,
    emoji,
    isTodo = false,
    bodyClass,
    ...props
} = Astro.props;

const TitleChild = titleLink ? "a" : Fragment;
---

<section class="info-block" {...props}>
    <h3 class="title">
        <TitleChild href={titleLink}>
            {emoji && <span class="emoji">{emoji}</span>}{title}</TitleChild
        >
    </h3>
    <section
        class:list={[
            "body",
            bodyClass,
            {
                "is-todo": isTodo,
            },
        ]}
    >
        {isTodo ? "待补充……" : <slot />}
    </section>
</section>

<style lang="less">
    @import "@/utils/mixins.less";

    .info-block {
        --title-border-x-offset: -0.3333em;
        --body-first-paragraph-margin-top: 0.75em;
        --dl-padding-left: 2.75em;
        --img-max-width: 75%;
        --img-max-height: calc(100vh - var(--global-sticky-top) - 10rem);

        .screen-lg({
            --img-max-width: calc(100% - var(--global-edge-safe-distance) * 2);
        });
        .screen-md-below({
            --img-max-width: 100%;
            --img-max-height: calc(100vh - var(--global-sticky-top) - 15rem);
        });

        position: relative;

        .title {
            display: block;
            font-size: 1em;
            font-weight: normal;
            color: var(--text-color-secondary);
            // opacity: 0.75;
            padding: 0 calc(var(--title-border-x-offset) * -1) 0.5em
                calc(var(--title-border-x-offset) * -1);
            border-bottom: 1px solid var(--border-color);
            margin: 0 var(--title-border-x-offset) 0.5em
                var(--title-border-x-offset);
            user-select: none;
            .emoji {
                display: inline-block;
                width: 1.5em;
            }
            & > a {
                .link-with-arrow-styles();
                &::before,
                &::after {
                    margin-top: -0.1em;
                }
            }
        }
        .body {
            color: var(--text-color-primary);
            // margin-top: 0.5em;
            // user-select: all;
            &.is-todo {
                color: var(--text-color-secondary);
            }
            :global(h4) {
                // margin-top: 1.5em;
                margin-bottom: 0.6667em;
                & ~ :global(h4) {
                    margin-top: 1.6667em;
                }
            }
            :global(h1),
            :global(h2),
            :global(h3),
            :global(h4),
            :global(h5),
            :global(h6),
            :global(ul),
            :global(p) {
                &:first-child {
                    margin-top: var(--body-first-paragraph-margin-top);
                }
                margin-top: 1.25em;
            }
            :global(ul ul) {
                margin-top: 0;
            }

            :global(dl) {
                display: block;
                margin: 0;
                position: relative;
                padding-left: var(--dl-padding-left);
                // color: var(--text-color-secondary);
                :global(dt) {
                    position: absolute;
                    top: 0;
                    left: 0;
                }
                :global(dd) {
                    --body-first-paragraph-margin-top: 0;
                    margin: 0;
                    &.code {
                        display: block;
                        font-family: var(--font-family-monospace);
                        color: var(--text-color-primary);
                        margin: 0;
                        text-align: left;
                        & > span {
                            display: inline-block;
                            white-space: nowrap;
                            &.dct {
                                color: var(--theme-color-invert-p-40);
                            }
                        }
                    }
                    & > :global(p),
                    & > :global(ul) {
                        margin: 0;
                    }
                    & > :global(ul) {
                        padding-left: 2em;
                    }
                }
            }

            :global(img) {
                display: block;
                width: 100%;
                height: 100%;
                max-width: var(--img-max-width);
                max-height: var(--img-max-height);
                margin-left: auto;
                margin-right: auto;
                object-fit: contain;
            }
            
            :global(code) {
                font-family: var(--font-family-monospace);
                position: relative;
                display: inline-block;
                padding: 0 0.33333em;
                margin-left: 0.3333em;
                margin-right: 0.3333em;
                font-size: 0.9em;
                vertical-align: baseline;
                &::after {
                    content: "";
                    position: absolute;
                    top: -0.03333em;
                    bottom: 0.15em;
                    left: -0.15em;
                    right: -0.15em;
                    border: 1px solid var(--border-color);
                    border-radius: 8px;
                    background: var(--tag-background-color);
                }
            }
        }
    }
</style>

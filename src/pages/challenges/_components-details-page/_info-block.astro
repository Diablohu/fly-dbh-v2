---
type Props = {
    title: string;
    titleLink?: string;
    emoji?: string;
    isTodo?: boolean;
    bodyClass?: string;
} & astroHTML.JSX.HTMLAttributes;

const {
    title,
    titleLink,
    emoji,
    isTodo = false,
    bodyClass,
    ...props
} = Astro.props;

const TitleChild = titleLink ? "a" : Fragment;
---

<section class="info-block" {...props}>
    <h3 class="title">
        <TitleChild href={titleLink}>
            {emoji && <span class="emoji">{emoji}</span>}{title}</TitleChild
        >
    </h3>
    <section
        class:list={[
            "body",
            bodyClass,
            {
                "is-todo": isTodo,
            },
        ]}
    >
        {isTodo ? "待补充……" : <slot />}
    </section>
</section>

<style lang="less">
    @import "@/utils/mixins.less";

    .info-block {
        --title-border-x-offset: -0.3333em;

        position: relative;

        .title {
            display: block;
            font-size: 1em;
            font-weight: normal;
            color: var(--text-color-secondary);
            // opacity: 0.75;
            padding: 0 calc(var(--title-border-x-offset) * -1) 0.5em
                calc(var(--title-border-x-offset) * -1);
            border-bottom: 1px solid var(--border-color);
            margin: 0 var(--title-border-x-offset) 0.5em
                var(--title-border-x-offset);
            user-select: none;
            .emoji {
                display: inline-block;
                width: 1.5em;
            }
            & > a {
                .link-with-arrow-styles();
                &::before,
                &::after {
                    margin-top: -0.1em;
                }
            }
        }
        .body {
            color: var(--text-color-primary);
            // margin-top: 0.5em;
            // user-select: all;
            &.is-todo {
                color: var(--text-color-secondary);
            }
            & > :global(p:first-child) {
                margin-top: 0;
            }

            dl {
                display: block;
                margin: 0;
                position: relative;
                padding-left: 2.75em;
                color: var(--text-color-secondary);
                dt {
                    position: absolute;
                    top: 0;
                    left: 0;
                }
                dd {
                    margin: 0;
                    &.code {
                        display: block;
                        font-family: var(--font-family-monospace);
                        color: var(--text-color-primary);
                        margin: 0;
                        text-align: left;
                        & > span {
                            display: inline-block;
                            white-space: nowrap;
                            &.dct {
                                color: var(--theme-color-invert-p-40);
                            }
                        }
                    }
                }
            }
        }
    }
</style>

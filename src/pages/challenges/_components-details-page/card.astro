---
type Props = {
    title: string;
};
---

<section class="card">
    <h3 class="title">{Astro.props.title}</h3>
    <section class="body">
        <slot />
    </section>
</section>

<style lang="less">
    @import "@/utils/mixins.less";

    .card {
        position: relative;
        border: var(--card-container-border-width) solid
            var(--card-container-border-color);
        border-radius: var(--card-container-border-radius);
        background: var(--card-container-background-color);
        box-shadow:
            var(--card-container-inset-shadow),
            var(--card-container-drop-shadow);
        padding: 0.6667em 1em;
        .title {
            display: block;
            font-size: 0.8em;
            font-weight: normal;
            color: var(--text-color-secondary);
            opacity: 0.75;
            margin: 0;
            user-select: none;
        }
        .body {
            margin-top: 0.5em;
            // user-select: all;
        }

        & + .card {
            margin-top: 2em;
        }
    }
</style>

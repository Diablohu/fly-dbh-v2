---
import { type ChallengeItemType } from "@/types";
import { type RunwayType } from "../_types";

import calculateRunwaySlope from "@/utils/calculate-runway-slope";

type Props = {
    aerodrome: ChallengeItemType["aerodrome"];
    targetRunways: ChallengeItemType["runways"];
    runwayPairs: [RunwayType, RunwayType][];
};
---

<section class="aerodrome-info">
    {
        Astro.props.aerodrome.photo && (
            <figure class="photo">
                <img
                    src={
                        Astro.props.aerodrome.photo + "?auto=format&w=640&q=60"
                    }
                    alt={`${Astro.props.aerodrome.name}${
                        Array.isArray(Astro.props.aerodrome.location) &&
                        Astro.props.aerodrome.location.length > 0
                            ? ` (${Astro.props.aerodrome.location.join(" ")})`
                            : ""
                    }`}
                    loading="lazy"
                />
                {Astro.props.aerodrome.photo_credit_url && (
                    <figcaption class="photo-credit">
                        <a
                            href={Astro.props.aerodrome.photo_credit_url}
                            target="_blank"
                        >
                            {Astro.props.aerodrome.photo_credit}
                        </a>
                    </figcaption>
                )}
            </figure>
        )
    }

    <div class="codes">
        <span data-type="icao">{Astro.props.aerodrome.icao || "-"}</span>
        <span data-type="iata">{Astro.props.aerodrome.iata || "-"}</span>
    </div>

    {
        Array.isArray(Astro.props.aerodrome.location) &&
            Astro.props.aerodrome.location.length > 0 && (
                <dl>
                    <>
                        <dt>地区</dt>
                        <dd>{Astro.props.aerodrome.location.join(" ")}</dd>
                    </>
                </dl>
            )
    }

    {
        Array.isArray(Astro.props.runwayPairs) &&
            Astro.props.runwayPairs.length > 0 && (
                <dl>
                    <>
                        <dt>跑道</dt>
                        {Astro.props.runwayPairs.map((runwayPair) => (
                            <dd
                                class:list={[
                                    "runway",
                                    {
                                        "is-current":
                                            runwayPair[0].isChallengePair,
                                    },
                                ]}
                            >
                                {[
                                    [
                                        "IDENTIFIER",
                                        ...runwayPair.map(
                                            (runway) => runway.identifier
                                        ),
                                    ],
                                    [
                                        "长宽",
                                        `${Math.round(runwayPair[0].lengthInMeters)} m x ${Math.round(runwayPair[0].widthInMeters)} m`,
                                    ],
                                    [
                                        "",
                                        `${Math.round(runwayPair[0].lengthInFeet)} ft x ${Math.round(runwayPair[0].widthInFeet)} ft`,
                                    ],
                                    [
                                        "磁航向",
                                        ...runwayPair.map(
                                            (runway) => runway.bearing + "°"
                                        ),
                                    ],
                                    [
                                        "标高",
                                        ...runwayPair.map(
                                            (runway) =>
                                                runway.elevationInFeet + " ft"
                                        ),
                                    ],
                                    [
                                        "坡度",
                                        ...(runwayPair[0].elevationInFeet ===
                                        runwayPair[1].elevationInFeet
                                            ? ["--"]
                                            : runwayPair.map(
                                                  (runway) =>
                                                      runway.slopepercentage.toFixed(
                                                          2
                                                      ) + "%"
                                              )),
                                    ],
                                    [
                                        "",
                                        ...(runwayPair[0].elevationInFeet ===
                                        runwayPair[1].elevationInFeet
                                            ? ["--"]
                                            : runwayPair.map(
                                                  (runway) =>
                                                      runway.slopeDegrees.toFixed(
                                                          2
                                                      ) + "°"
                                              )),
                                    ],
                                ].map(([label, value1, value2]) => (
                                    <span class="detail">
                                        <strong>{label}</strong>
                                        <em>{value1}</em>
                                        {value2 && <em>{value2}</em>}
                                    </span>
                                ))}
                            </dd>
                        ))}
                    </>
                </dl>
            )
    }
</section>

<style lang="less">
    @import "@/utils/mixins.less";

    .aerodrome-info {
        position: relative;
    }

    figure.photo {
        display: block;
        margin: -1em -1em auto -1em;
        & > img {
            display: block;
            width: 100%;
        }
    }
</style>

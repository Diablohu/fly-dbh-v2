---
type Props = {
    title: string;
    emoji?: string;
} & astroHTML.JSX.HTMLAttributes;

const { title, emoji, ...props } = Astro.props;
---

<section class="info-block" {...props}>
    <h3 class="title">
        {emoji && <span class="emoji">{emoji}</span>}{title}
    </h3>
    <section class="body">
        <slot />
    </section>
</section>

<style lang="less">
    @import "@/utils/mixins.less";

    .info-block {
        position: relative;

        .title {
            display: block;
            font-size: 1em;
            font-weight: normal;
            color: var(--text-color-secondary);
            // opacity: 0.75;
            padding: 0 0.3333em 0.5em 0.3333em;
            border-bottom: 1px solid var(--border-color);
            margin: 0 -0.3333em 0.5em -0.3333em;
            user-select: none;
        }
        .body {
            color: var(--text-color-primary);
            // margin-top: 0.5em;
            // user-select: all;
        }
    }
</style>

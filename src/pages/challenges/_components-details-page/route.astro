---
import { type ChallengeItemType } from "@/types";

import InfoBlock from "./_info-block.astro";

type Props = {
    route: ChallengeItemType["route"];
} & astroHTML.JSX.HTMLAttributes;

const { route, ...props } = Astro.props;

function parseArrStr(string: string) {
    return string
        .split("/")
        .map((part) => part.trim())
        .join(" / ");
}
---

<InfoBlock
    {...props}
    title="示例航线"
    emoji="🌏"
    isTodo={!route.origin?.icao && !route.origin?.iata}
>
    <dl>
        <dt>起飞</dt>
        <dd class="code">
            {
                [route.origin?.icao, route.origin?.iata]
                    .filter(Boolean)
                    .join(" / ")
            }
        </dd>
    </dl>
    <dl>
        <dt>离场</dt>
        {
            Array.isArray(route.sid) ? (
                <dd class="procedures">
                    {route.sid.map(({ rwy, sid }) => (
                        <span>
                            {rwy && (
                                <>
                                    <em>{parseArrStr(rwy)}</em>{" "}
                                    <span class="rwy">跑道</span> ＞
                                </>
                            )}
                            <em>{parseArrStr(sid)}</em>
                        </span>
                    ))}
                </dd>
            ) : (
                <dd>无程序</dd>
            )
        }
    </dl>
    <dl>
        <dt>线路</dt>
        {
            route.enroute ? (
                <dd class="code">
                    {route.enroute.split(" ").map((part) => (
                        <span class={part === "DCT" ? "dct" : null}>
                            {part}&nbsp;
                        </span>
                    ))}
                </dd>
            ) : (
                <dd>直飞</dd>
            )
        }
    </dl>
    <dl>
        <dt>目的</dt>
        <dd class="code">
            {
                [route.destination?.icao, route.destination?.iata]
                    .filter(Boolean)
                    .join(" / ")
            }
        </dd>
    </dl>
    <dl>
        <dt>进场</dt>
        {
            Array.isArray(route.star) ? (
                <dd class="procedures">
                    {route.star.map(({ rwy, star }) => (
                        <span>
                            <em>{parseArrStr(star)}</em>
                            {rwy && (
                                <>
                                    ＞ <em>{parseArrStr(rwy)}</em>{" "}
                                    <span class="rwy">跑道</span>
                                </>
                            )}
                        </span>
                    ))}
                </dd>
            ) : (
                <dd>无程序</dd>
            )
        }
    </dl>
    <dl>
        <dt>进近</dt>
        {
            route.app ? (
                <dd class="code">
                    {route.app.split(" ").map((part) => (
                        <span class={part === "via" ? "via" : null}>
                            {part}&nbsp;
                        </span>
                    ))}
                </dd>
            ) : (
                <dd>无程序</dd>
            )
        }
    </dl>
    <dl>
        <dt>长度</dt>
        {route.distance ? <dd>约 {route.distance} 海里</dd> : <dd>未知</dd>}
    </dl>
    <dl>
        <dt>巡航</dt>
        {route.cruise ? <dd>{route.cruise}</dd> : <dd>无（保持 VFR）</dd>}
    </dl>
</InfoBlock>

<style lang="less">
    @import "@/utils/mixins.less";

    dl {
        display: block;
        margin: 0;
        position: relative;
        padding-left: 2.75em;
        color: var(--text-color-secondary);
        dt {
            position: absolute;
            top: 0;
            left: 0;
        }
        dd {
            margin: 0;
            &.code {
                display: block;
                font-family: var(--font-family-monospace);
                color: var(--text-color-primary);
                margin: 0;
                text-align: left;
                & > span {
                    display: inline-block;
                    white-space: nowrap;
                }
            }
            &.procedures {
                & > span {
                    display: block;
                    & > em {
                        font-family: var(--font-family-monospace);
                        font-style: normal;
                        color: var(--text-color-primary);
                    }
                }
            }
            .rwy,
            .dct,
            .via {
                // color: var(--theme-color-invert-p-40);
                color: var(--text-color-secondary);
            }
        }
    }
</style>

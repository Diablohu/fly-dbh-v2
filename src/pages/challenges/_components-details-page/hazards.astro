---
import { type ChallengeItemType } from "@/types";
import { type RunwayType } from "../_types";

import InfoBlock from "./_info-block.astro";

type Props = {
    hazards: ChallengeItemType["hazards"];
    challengeRunways: RunwayType[];
} & astroHTML.JSX.HTMLAttributes;

const { hazards, challengeRunways, ...props } = Astro.props;
console.log({ challengeRunways });
---

<InfoBlock {...props} title="难点灾害" emoji="🥵">
    {
        hazards.map((hazard) => (
            <span class="hazard" data-difficulty={hazard.difficulty}>
                <em class="icon" aria-hidden="true">
                    {hazard.emoji}
                </em>
                {[
                    hazard.name,
                    hazard.comment,
                    hazard.extra_comment
                        ? hazard.extra_comment
                        : !Array.isArray(challengeRunways)
                          ? null
                          : hazard.name.includes("大坡度跑道") &&
                              challengeRunways[0]
                            ? `${
                                  // 如果所有跑道的坡度统一为上坡或下坡，显示对应的文字
                                  challengeRunways.every(
                                      (runway) => runway.slopePercentage > 0,
                                  )
                                      ? "上坡 "
                                      : challengeRunways.every(
                                              (runway) =>
                                                  runway.slopePercentage < 0,
                                          )
                                        ? "下坡 "
                                        : ""
                              }${Math.abs(
                                  challengeRunways[0].slopePercentage,
                              ).toFixed(2)}% / ${Math.abs(
                                  challengeRunways[0].slopeDegrees,
                              ).toFixed(2)}°`
                            : null,
                ]
                    .filter(Boolean)
                    .map((text) => (
                        <span
                            class:list={[
                                "fragment",
                                {
                                    "is-start-with-bracket":
                                        typeof text === "string" &&
                                        /^[\(（)]/.test(text),
                                },
                            ]}
                            set:text={text}
                        />
                    ))}
            </span>
        ))
    }
</InfoBlock>

<style lang="less">
    @import "@/utils/mixins.less";

    .hazard {
        .difficulty-variables();
        display: block;
        padding-left: 1.5em;
        position: relative;
        color: var(--difficulty-color);
        .icon {
            display: inline-block;
            font-style: normal;
            position: absolute;
            top: 0;
            left: 0;
        }
        // .name {
        //     color: var(--text-color-primary);
        //     font-weight: normal;
        // }
        .fragment {
            font-weight: normal;
            display: inline-block;
            &:has(+ .fragment:not(.is-start-with-bracket)) {
                &::after {
                    content: "：";
                }
            }
        }
        // .extra-comment {
        //     display: block;
        //     margin-top: -0.5em;
        //     color: var(--text-color-primary);
        // }
    }
</style>

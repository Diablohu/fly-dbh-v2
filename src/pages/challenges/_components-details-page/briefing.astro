---
import { type ChallengeItemType } from "@/types";
import { getVideoPageLink } from "@/global";
import parseMarkdown from "@/utils/parse-markdown";

import InfoBlock from "./_info-block.astro";
import TagButton from "@/components/tag-button.astro";

type Props = Pick<ChallengeItemType, "briefing" | "type"> & {
    urlBriefing?: ChallengeItemType["video_url_briefing"];
    videoExtremeAirport?: ChallengeItemType["video_this_aerodrome_extreme_airport"];
} & astroHTML.JSX.HTMLAttributes;

const { briefing, type, urlBriefing, videoExtremeAirport, ...props } =
    Astro.props;
// ifr-circling
---

<InfoBlock {...props} title="进近说明 & 航图" emoji="🗺️" isTodo={!briefing}>
    <!-- urlBriefing -->
    {
        (Array.isArray(urlBriefing) || videoExtremeAirport?._id) && (
            <section class="brefing-video">
                {urlBriefing?.map(({ name, url }) => (
                    <TagButton
                        href={url}
                        target="_blank"
                        rel="nofollow noopener noreferrer external"
                    >
                        <strong>
                            {["观看简令视频", name].filter(Boolean).join(" : ")}
                        </strong>
                        <em>@ 哔哩哔哩</em>
                    </TagButton>
                ))}
                {videoExtremeAirport?._id && (
                    <TagButton
                        href={getVideoPageLink(
                            videoExtremeAirport?._id ||
                                videoExtremeAirport?.slug ||
                                ""
                        )}
                        class="is-extreme-airport"
                    >
                        <strong>
                            {["观看极限机场"].filter(Boolean).join(" : ")}
                        </strong>
                        <em>专题报道视频</em>
                    </TagButton>
                )}
            </section>
        )
    }
    <section class="briefing">
        {
            type === "vfr" ? (
                <Fragment
                    set:html={
                        briefing &&
                        parseMarkdown(`#### 目视进近 *Visual Approach*
* 在飞行电脑中无法选择对应程序；
* 遵循 VFR 目视飞行规则，没有决断高度概念。`)
                    }
                />
            ) : type === "rnp-ar" ? (
                <Fragment
                    set:html={
                        briefing &&
                        parseMarkdown(`#### RNP (AR) 进近 *RNP (AR) Approach*
* 飞行电脑内可选择对应的 RNAV 进近程序；
* 该进近类型的导航精度极高；
* 现实运作中，需要飞机与机组都有对应资质，同时要求在进近时飞机的导航精度满足指定程序需要。`)
                    }
                />
            ) : type === "rnp-visual" ? (
                <Fragment
                    set:html={
                        briefing &&
                        parseMarkdown(`#### RNP 目视进近 *RNP Visual Approach*
* 飞行电脑内可选择对应的 RNAV 进近程序；
* 虽然该进近类型的导航精度很高，但所选择的这个进近方式并没有对准跑道，故最终进近阶段需要目视手操；
* 该进近方式仅用于定位机场。`)
                    }
                />
            ) : type === "circling" ? (
                <Fragment
                    set:html={
                        briefing &&
                        parseMarkdown(`#### 目视盘旋进近 *Circling Approach*
* 按选定的仪表进近程序飞行，直至目视盘旋最低下降高度，即航图上的 \`CIRCLING MDA(H)\` (LIDO) 或 \`CIRCLE-TO-LAND MDA(H)\` (杰普逊)；
* 之后转为目视进近，自行目视手操降落到目标跑道。`)
                    }
                />
            ) : type === "ils" ? (
                <Fragment
                    set:html={
                        briefing &&
                        parseMarkdown(`#### ILS 进近 *Instrument Landing System Approach*
* “盲降”进近；
* 根据航图，在飞行电脑中输入/确认 \`ILS 频率\`，部分机型还需要在自动驾驶面板手动调节航迹 \`Course\`；
* 确保飞机自动驾驶系统先后截获 \`航向道 LOC (Localizer)\` 和 \`下滑道 G/S (Glide Slope)\`。`)
                    }
                />
            ) : (
                ""
            )
        }
        <Fragment set:html={briefing && parseMarkdown(briefing)} />
    </section>
</InfoBlock>

<style lang="less">
    @import "@/utils/mixins.less";

    .briefing {
        --img-max-width: 75%;

        .screen-lg({
            --img-max-width: calc(100% - var(--global-edge-safe-distance) * 2);
        });
        .screen-md-below({
            --img-max-width: 100%;
        });

        :global(h4) {
            // margin-top: 1.5em;
            margin-bottom: 0.6667em;
            & ~ :global(h4) {
                margin-top: 1.6667em;
            }
        }
        & > :global(h1),
        & > :global(h2),
        & > :global(h3),
        & > :global(h4),
        & > :global(h5),
        & > :global(h6) {
            margin-top: 1em;
        }
        :global(ul) {
            padding-left: 2em;
        }
        :global(img) {
            display: block;
            max-width: var(--img-max-width);
            max-height: calc(100vh - var(--global-sticky-top) - 15rem);
            margin-left: auto;
            margin-right: auto;
        }
        :global(code) {
            font-family: var(--font-family-monospace);
            position: relative;
            display: inline-block;
            padding: 0 0.33333em;
            margin-left: 0.3333em;
            margin-right: 0.3333em;
            font-size: 0.9em;
            vertical-align: baseline;
            &::after {
                content: "";
                position: absolute;
                top: -0.03333em;
                bottom: 0.15em;
                left: -0.15em;
                right: -0.15em;
                border: 1px solid var(--border-color);
                border-radius: 8px;
                background: var(--tag-background-color);
            }
        }
    }

    .brefing-video {
        --container-display: flex;
        --container-float: right;
        --container-margin-top: -0.5em;
        --container-margin-left: 0;
        --container-text-align: unset;
        --item-margin-right: 0;

        display: var(--container-display);
        flex-flow: column nowrap;
        gap: 0;
        float: var(--container-float);
        margin-top: var(--container-margin-top);
        margin-left: var(--container-margin-left);
        margin-right: var(--title-border-x-offset);
        text-align: var(--container-text-align);
        .screen-md-below({
            --container-display: block;
            --container-float: none;
            --container-margin-top: 1em;
            --container-margin-left: auto;
            --item-margin-right: calc(var(--title-border-x-offset) * -1);
            --container-text-align: center;
        });
        &::before,
        &::after {
            content: "";
            flex: 1;
        }
        & > a {
            --icon-emoji: "▶️";
            flex: none;
            font-size: 14px;
            display: inline-block;
            position: relative;
            padding: 0.5em 1em 0.5em 3.6667em;
            margin-bottom: 0.5em;
            margin-right: var(--item-margin-right);
            text-align: left;
            // border: 1px solid var(--text-color-secondary);
            &::before {
                content: var(--icon-emoji);
                position: absolute;
                font-size: 2.6em;
                top: 0.66em;
                left: 0em;
                display: block;
                width: 0;
                height: 0;
                line-height: 0;
            }
            small,
            strong,
            em {
                display: block;
            }
            strong {
                font-size: 1.2em;
                line-height: 1;
            }
            em {
                font-size: 1em;
                line-height: 1;
                margin-top: 0.3333em;
                color: var(--text-color-secondary);
                font-style: normal;
            }
            &.is-extreme-airport {
                --icon-emoji: "🚩";
            }
        }
    }
</style>

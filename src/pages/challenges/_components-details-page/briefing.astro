---
import { type ChallengeItemType } from "@/types";
import { getVideoPageLink } from "@/global";

import InfoBlock from "./_info-block.astro";
import TagButton from "@/components/tag-button.astro";
import Markdown from "@/components/markdown.astro";

import MovieSVG from "@/assets/svg-symbols/movie.svg";
import MonitorPlaySVG from "@/assets/svg-symbols/monitor-play.svg";

type Props = Pick<ChallengeItemType, "briefing" | "type" | "aerodrome"> & {
    urlBriefing?: ChallengeItemType["video_url_briefing"];
    videoExtremeAirport?: ChallengeItemType["video_this_aerodrome_extreme_airport"];
} & astroHTML.JSX.HTMLAttributes;

const {
    briefing,
    type,
    urlBriefing,
    videoExtremeAirport,
    aerodrome,
    ...props
} = Astro.props;
---

<InfoBlock {...props} title="进近说明 & 航图" emoji="🗺️" isTodo={!briefing}>
    {
        (Array.isArray(urlBriefing) || videoExtremeAirport?._id) && (
            <section class="brefing-video">
                {urlBriefing?.map(({ name, url }) => (
                    <TagButton
                        href={url}
                        target="_blank"
                        rel="nofollow noopener noreferrer external"
                    >
                        <MonitorPlaySVG slot="prefix" />
                        <strong>
                            {["观看简令视频", name].filter(Boolean).join(" : ")}
                        </strong>
                        <em>@ 哔哩哔哩</em>
                    </TagButton>
                ))}
                {videoExtremeAirport?._id && (
                    <TagButton
                        href={getVideoPageLink(
                            videoExtremeAirport?.slug ||
                                videoExtremeAirport?._id ||
                                "",
                        )}
                        class="is-extreme-airport"
                    >
                        <MovieSVG slot="prefix" />
                        <strong>观看极限机场</strong>
                        <em>专题报道视频</em>
                    </TagButton>
                )}
            </section>
        )
    }
    {
        briefing && (
            <section class="briefing">
                <Markdown
                    src={[
                        type === "vfr"
                            ? `#### 目视进近 *Visual Approach*
* 在飞行电脑中无法选择对应程序；
* 遵循 VFR 目视飞行规则，没有决断高度概念。`
                            : type === "vpt"
                              ? `#### 有既定线路的目视进近 *Visual Approach with Prescribed Flight Tracks (VPT)*
* 这是一种目视进近，所以在飞行电脑中无法选择对应程序；
* 需要按照设定的线路和高度飞行。建议预先在飞行电脑中设定导航参考；
* 但由于无法选择对应程序，所以飞机航电不会提供飞行指引。`
                              : type === "rnp-ar"
                                ? `#### RNP (AR) 进近 *RNP (AR) Approach*
* 飞行电脑内可选择对应的 \`RNAV\` 进近程序；
* 该进近类型的导航精度极高；
* 现实运作中，需要飞机与机组都有对应资质，同时要求在进近时飞机的导航精度满足指定程序需要。`
                                : type === "rnp-visual"
                                  ? `#### RNP 目视进近 *RNP Visual Approach*
* 飞行电脑内可选择对应的 \`RNAV\` 进近程序；
* 虽然该进近类型的导航精度很高，但所选择的这个进近方式并没有对准跑道，故最终进近阶段需要目视手操；
* 该进近方式仅用于定位机场。`
                                  : type === "circling"
                                    ? `#### 目视盘旋进近 *Circling Approach*
* 按选定的仪表进近程序飞行，直至目视盘旋最低下降高度，即航图上的 \`CIRCLING MDA(H)\` (LIDO) 或 \`CIRCLE-TO-LAND MDA(H)\` (杰普逊)；
* 之后转为目视进近，自行目视手操降落到目标跑道。`
                                    : type === "ils"
                                      ? `#### ILS 进近 *Instrument Landing System Approach*
* “盲降”进近；
* 根据航图，在飞行电脑中输入/确认 \`ILS\` 频率，部分机型还需要在自动驾驶面板手动调节航迹 \`Course\`；
* 确保飞机自动驾驶系统先后截获 **航向道** \`LOC (Localizer)\` 和 **下滑道** \`G/S (Glide Slope)\`，并按指引飞行。`
                                      : type === "igs"
                                        ? `#### IGS 进近 *Instrument Guidance System Approach*
* 与 ILS “盲降”进近类似，都有提供 **航向道** \`LOC (Localizer)\` 和 **下滑道** ` +
                                          "`G/S (Glide Slope)` 信号；" +
                                          `
* 因为航向道或下滑道会有甚大偏差，所以起了个新的名字，以作为和传统盲降的区分；
* 根据航图，在飞行电脑中输入/确认 \`IGS\` 频率，部分机型还需要在自动驾驶面板手动调节航迹 \`Course\`；
* 确保飞机自动驾驶系统先后截获 **航向道** 和 **下滑道**，并按指引飞行。`
                                        : type === "loc"
                                          ? `#### LOC 进近 *Localizer Approach*
* 仅提供精密的水平航向道指引，没有 **下滑道** ` +
                                            "`G/S (Glide Slope)` 指引；" +
                                            `
* 根据航图，在飞行电脑中输入/确认 \`LOC\` 频率，部分机型还需要在自动驾驶面板手动调节航迹 \`Course\`；
* 确保飞机自动驾驶系统截获 **航向道** \`LOC (Localizer)\`，并按指引飞行；；
* 之后按飞机的 VNAV 垂直导航指引，或目视自行控制下降。`
                                          : type === "lda"
                                            ? `#### LDA 进近 *Localizer-Type Directional Aid*
* 使用有较大偏移的 **航向道** \`LOC (Localizer)\` 信号，提供非精密的水平航向指引；
* 没有 **下滑道** ` +
                                              "`G/S (Glide Slope)` 指引；" +
                                              `
* 根据航图，在飞行电脑中输入/确认 \`LOC\` 频率，部分机型还需要在自动驾驶面板手动调节航迹 \`Course\`；
* 确保飞机自动驾驶系统截获 **航向道** \`LOC (Localizer)\`，并按指引飞行；；
* 之后按飞机的 VNAV 垂直导航指引，或目视自行控制下降；
* 根据航图定义，目视手操最准跑道，降落。`
                                            : "",

                        aerodrome.is_closed
                            ? `#### 机场已停用

在《微软模拟飞行》系列中，可使用 \`${[aerodrome.icao, aerodrome.iata, aerodrome.faa].filter(Boolean).join(" / ")}\` 代码使用该机场。
`
                            : "",

                        aerodrome.icao && aerodrome.is_fake_icao
                            ? `#### 关于机场代码
在《微软模拟飞行》系列中，该机场被赋予了 \`${aerodrome.icao}\` 这个 ICAO 代码。
但现实中这座机场并没有这个 ICAO 代码${!aerodrome.iata ? "，也没有 IATA 代码" : ""}，所以游戏自行添加了一个虚构的 ICAO 代码。${
                                  aerodrome.designator
                                      ? `

这座机场有一个唯一识别码：\`${aerodrome.designator}\`。
`
                                      : ""
                              }`
                            : "",

                        briefing,
                    ]
                        .filter(Boolean)
                        .join("\n\n")}
                />
            </section>
        )
    }
</InfoBlock>

<style lang="less">
    @import "@/utils/mixins.less";

    .brefing-video {
        --container-position: sticky;
        --container-display: flex;
        --container-float: right;
        --container-margin-top: -0.25em;
        --container-margin-bottom: 0;
        --container-margin-left: 1em;
        --container-text-align: unset;
        --item-margin-right: 0;
        --item-backdrop-filter: var(--global-header-backdrop-filter);
        --item-extra-background-display: block;
        --text-color: var(--text-color-secondary);
        // --text-shadow: 0 0.025em 0.15em var(--shadow-color);

        position: var(--container-position);
        top: calc(var(--global-sticky-top) + 1rem);
        z-index: calc(var(--title-block-z-index) + 10);
        display: var(--container-display);
        flex-flow: column nowrap;
        gap: 0;
        float: var(--container-float);
        margin-top: var(--container-margin-top);
        margin-bottom: var(--container-margin-bottom);
        margin-left: var(--container-margin-left);
        margin-right: var(--title-border-x-offset);
        text-align: var(--container-text-align);
        // text-shadow: var(--text-shadow);
        .screen-md-below({
            --container-position: static;
            --container-display: block;
            --container-float: none;
            --container-margin-top: 1em;
            --container-margin-bottom: -0.25em;
            --container-margin-left: auto;
            --item-backdrop-filter: none;
            --item-margin-right: calc(var(--title-border-x-offset) * -1);
            --item-extra-background-display: none;
            --container-text-align: center;
            // --text-shadow: none;
        });
        &::before,
        &::after {
            content: "";
            flex: 1;
        }
        & > a {
            flex: none;
            font-size: 14px;
            display: inline-block;
            position: relative;
            padding: 0.5em 1em 0.5em 4em;
            margin-bottom: 0.5em;
            margin-right: var(--item-margin-right);
            text-align: left;
            color: var(--text-color);
            box-shadow: 0 4px 10px 0 var(--theme-color);
            // background: var(--theme-color);
            // border: 1px solid var(--text-color-secondary);
            &::before {
                display: var(--item-extra-background-display);
                content: "";
                position: absolute;
                top: 0;
                bottom: 0;
                left: 0;
                right: 0;
                background: var(--theme-color-p-50);
                z-index: -1;
                backdrop-filter: var(--item-backdrop-filter);
            }
            & > :global(.prefix) {
                --size: 2.25em;
                position: absolute;
                top: 0;
                bottom: 0;
                left: 0;
                width: calc(var(--size) * 1.6667);
                & > svg {
                    position: absolute;
                    top: 50%;
                    left: 1em;
                    margin-top: calc(var(--size) / -2);
                    display: block;
                    width: var(--size);
                    height: var(--size);
                    line-height: 0;
                    color: currentColor;
                    transition: var(--base-transition-duration);
                    transition-property: fill, color;
                }
            }
            small,
            strong,
            em {
                display: block;
            }
            strong {
                font-size: 1.2em;
                line-height: 1;
                color: var(--text-color-primary);
            }
            em {
                font-size: 1em;
                line-height: 1;
                margin-top: 0.3333em;
                font-style: normal;
            }
            // &.is-extreme-airport {
            // }
            &:hover {
                --text-color: var(--text-color-primary);
            }
        }
    }

    .briefing {
        :global(ul) {
            padding-left: 2em;
        }
        :global(table) {
            width: 100%;
        }
    }
</style>

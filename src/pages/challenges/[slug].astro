---
import { actions, ActionError } from "astro:actions";
import { type RunwayType } from "./_types";

import Layout from "@/layouts/layout.astro";

import Title from "./_components-details-page/title";
import AerodromeInfo from "./_components-details-page/aerodrome-info.astro";
import Facts from "./_components-details-page/facts.astro";
import Hazards from "./_components-details-page/hazards.astro";
import Route from "./_components-details-page/route.astro";
import Briefing from "./_components-details-page/briefing.astro";
import OtherChallenges from "./_components-details-page/other-challenges.astro";
import Videos from "./_components-details-page/videos.astro";
import FreeAddons from "./_components-details-page/free-addons.astro";

import calculateRunwaySlope, {
    transformSlopePercentageToDegrees,
} from "@/utils/calculate-runway-slope";
import { errorLog } from "@/utils/log";

// ============================================================================

if (!Astro.params.slug) return Astro.redirect(routeBase.challenges, 303);

const { data: challenge, error } = await Astro.callAction(
    actions.challengePage.fetchChallenge,
    Astro.params.slug,
);
if ((error && error.code === "NOT_FOUND") || !challenge) {
    if (error)
        errorLog(
            [
                `${Astro.originPathname} -> 404`,
                error.code,
                error.message,
                (error.cause as any)?.GROQ
                    ? `GROQ: "${(error.cause as any)?.GROQ.replace(/\n\s+/gm, " ")}"`
                    : "",
            ]
                .filter(Boolean)
                .join(" | "),
        );
    else
        errorLog(
            [`${Astro.originPathname} -> 404`, "No challenge found"]
                .filter(Boolean)
                .join(" | "),
        );
    return Astro.rewrite("/404");
}
if (error) {
    const err = error as unknown as ActionError;
    errorLog(
        [
            `${Astro.originPathname} -> 500`,
            err.code,
            err.message,
            (err.cause as any)?.GROQ
                ? `GROQ: "${(err.cause as any)?.GROQ.replace(/\n\s+/gm, " ")}"`
                : "",
        ]
            .filter(Boolean)
            .join(" | "),
    );
    Astro.response.status = 500;
    Astro.props.error = error;
    return Astro.rewrite("/500");
}

// ============================================================================

/**
 * 计算后的跑道信息，挑战目标的跑道组排列在前，信息额外包含：
 *  - 标记是否为挑战目标跑道
 *  - 长度（ft）
 *  - 坡度（%）
 *  - 坡度（°）
 */
const runwayPairs: [RunwayType, RunwayType][] = challenge.aerodrome.runways
    ?.map((runway) => {
        const identifiers = runway.identifier.split("/").map((id) => id.trim());
        const bearings = runway.bearing
            .split("/")
            .map((bearing) => bearing.trim());
        const elevationsInFeet = (
            runway.elevation.includes("/")
                ? runway.elevation.split("/")
                : [runway.elevation, runway.elevation]
        ).map((v) => parseInt(v.trim()));

        const lengthInFeet = parseInt(runway.length);
        const widthInFeet = parseInt(runway.width);

        const slopPercentageOverride = runway.slope
            ? runway.slope.split("/").map((bearing) => Number(bearing.trim()))
            : undefined;

        const isChallengePair =
            !Array.isArray(challenge.runways) ||
            challenge.runways.some((challengeRunway) =>
                runway.identifier.includes(challengeRunway),
            );

        return [0, 1].map((index) => {
            const slopeInfo = Array.isArray(slopPercentageOverride)
                ? {
                      percentage: slopPercentageOverride[index],
                      degrees: transformSlopePercentageToDegrees(
                          slopPercentageOverride[index],
                      ),
                  }
                : calculateRunwaySlope(
                      elevationsInFeet[index],
                      elevationsInFeet[index === 0 ? 1 : 0],
                      lengthInFeet,
                  );
            return {
                identifier: identifiers[index],
                isChallengePair,
                isChallengeRunway:
                    isChallengePair &&
                    (!Array.isArray(challenge.runways) ||
                        challenge.runways.includes(identifiers[index])),
                bearing: bearings[index],
                lengthInFeet,
                lengthInMeters: lengthInFeet * 0.3048,
                widthInFeet,
                widthInMeters: widthInFeet * 0.3048,
                elevationInFeet: elevationsInFeet[index],
                elevationInMeters: elevationsInFeet[index] * 0.3048,
                slopePercentage: slopeInfo.percentage,
                slopeDegrees: slopeInfo.degrees,
                slopeTooSmall: Math.abs(slopeInfo.percentage) < 0.1,
            };
        }) as [RunwayType, RunwayType];
    })
    ?.sort((pairA, pairB) => {
        if (
            pairA.some((runway) => runway.isChallengePair) &&
            pairB.some((runway) => runway.isChallengePair)
        )
            return 0;
        if (pairA.some((runway) => runway.isChallengePair)) return -1;
        return 1;
    });

/** 当前挑战的跑道信息 */
const challengeRunways = runwayPairs
    ?.flat()
    .filter((runway) => runway.isChallengeRunway);

// console.log(challengeRunways);
// console.log(challenge)
---

<Layout
    title={challenge.aerodrome.name +
        (Array.isArray(challenge.aerodrome.location) &&
        challenge.aerodrome.location.length > 0
            ? ` (${challenge.aerodrome.location.join(" ")}) `
            : "") +
        `进近挑战 : ${challenge.name}` +
        " | 模拟飞行挑战"}
    header
    footer
    htmlClassList={["page-challenge-details"]}
>
    <div class="challenge-details-page">
        <div class="wrapper">
            <Title
                client:idle
                aerodromeName={challenge.aerodrome.name}
                challengeName={challenge.name}
                airacCycle={challenge.airac_cyle}
            />

            <section class="aerodrome-info">
                <div class="wrapper">
                    <AerodromeInfo
                        aerodrome={challenge.aerodrome}
                        targetRunways={challenge.runways}
                        runwayPairs={runwayPairs}
                    />
                </div>
            </section>

            <section class="content">
                <Facts
                    difficulty={challenge.difficulty}
                    maxCategory={challenge.max_allowed_aircraft_category}
                    typicalAircrafts={challenge.typical_aircrafts}
                    data-info="facts"
                />
                <Hazards
                    hazards={challenge.hazards}
                    challengeRunways={challengeRunways}
                    data-info="hazards"
                />
                <Route route={challenge.route} data-info="route" />
                <Briefing
                    briefing={challenge.briefing}
                    type={challenge.type}
                    urlBriefing={challenge.video_url_briefing}
                    videoExtremeAirport={challenge.video_this_aerodrome_extreme_airport}
                    data-info="briefing"
                />
                <FreeAddons
                    freeAddons={challenge.aerodrome.free_addons}
                    freeSceneryAddons={challenge.aerodrome.free_addons_scenery}
                    data-info="free-addons"
                />
                <OtherChallenges
                    list={challenge.other_challenges_this_aerodrome}
                    data-info="other-challenges"
                />
                <Videos
                    list={challenge.videos_this_aerodrome}
                    aerodromeSlug={challenge.aerodrome.slug}
                    data-info="videos"
                />

                <!-- <section>TODO: Back to List & Latest Items</section> -->
            </section>
        </div>
    </div>
</Layout>

<style lang="less">
    @import "@/utils/mixins.less";

    // :global(:root.page-challenge-details) {
    //     --global-header-glossy-extra-height: 4rem;
    // }

    .challenge-details-page {
        // --title-block-z-index: calc(var(--global-header-z-index) + 1);
        --title-block-z-index: 10;
        --card-container-padding: 1em;
        --card-container-background-color: var(--theme-color-p-40);
        --card-container-border-width: 1px;
        --card-container-border-color: var(--border-color);
        --card-container-border-radius: 0.8em;
        --card-container-drop-shadow: 0 0.2em 1em #00000030;
        --card-container-inset-shadow: "";
        .color-scheme-light({
            --card-container-border-color: var(--theme-color-p-30);
            --card-container-drop-shadow: 0 0.2em 1em #0000001f;
            --card-container-inset-shadow: 0 0 1em #0000000a;
        });

        .block-component-styles();
        // position: static;
        user-select: unset;
        & > .wrapper {
            .block-wrapper-component-styles();
            // position: static;
            display: grid;
            grid-template-columns: calc(var(--global-sidebar-width) * 1.25) 1fr;
            grid-template-rows: auto auto 1fr;
            grid-template-areas:
                "aerodrome-info title"
                "aerodrome-info content"
                "aerodrome-info placeholder";
            gap: 0 var(--global-edge-safe-distance);
            padding-top: 1em;
            padding-bottom: 4em;
            &::after {
                content: "";
                grid-area: placeholder;
            }
        }
    }

    .aerodrome-info {
        position: sticky;
        align-self: start;
        grid-area: aerodrome-info;
        top: calc(var(--global-sticky-top) + 1em);
        // z-index: calc(var(--global-header-z-index) + 1);
        z-index: 10;
        margin-bottom: 2em;
        overflow: hidden;
        overscroll-behavior: contain;
        border-radius: var(--card-container-border-radius);
        // box-shadow: var(--overlay-box-shadow);
        // box-shadow: 0 2px 5px 0 #00000010;
        box-shadow: var(--card-container-drop-shadow);
        & > .wrapper {
            position: relative;
            z-index: 5;
            height: 100%;
            overflow: auto;
            max-height: calc(100dvh - var(--global-sticky-top) - 2em);
            padding: 1em 1em 0.8em 1em;
            overscroll-behavior: inherit;
            scrollbar-width: thin;
            border: var(--card-container-border-width) solid
                var(--card-container-border-color);
            border-radius: inherit;
            background: var(--card-container-background-color);
            box-shadow: var(--card-container-inset-shadow);
            // scrollbar-width: none;
            // &:hover {
            //     scrollbar-width: thin;
            // }
            .screen-sm({
                max-height: none;
            });
        }
    }

    .content {
        grid-area: content;
        z-index: 1;
        display: flex;
        flex-flow: row wrap;
        gap: 3em 2em;
        margin-top: 2em;
        & > * {
            flex: 1 1 100%;
        }
        & > [data-info="facts"],
        & > [data-info="hazards"],
        & > [data-info="route"],
        & > [data-info="free-addons"] {
            flex-basis: var(--body-safe-min-width);
        }
    }

    .debug {
        display: block;
        width: 100%;
        height: 20em;
        font-family: monospace;
    }

    //

    .styles-screen-sm() {
        .challenge-details-page {
            & > .wrapper {
                display: block;
            }
            .aerodrome-info {
                position: relative;
                z-index: 1;
                top: 0;
                margin-top: 2em;
                margin-bottom: 3em;
                overscroll-behavior: unset;
            }
        }
    }
    .screen-sm({
        .styles-screen-sm();
    });
</style>

---
import type { ComponentProps } from "astro/types";
import { actions } from "astro:actions";
import Layout from "@/layouts/layout.astro";

import LoginForm from "./login-form";
import ReGenCode from "./re-gen-code";

type Props = {
    title?: string;
    showTitle?: boolean;
    layout?: ComponentProps<typeof Layout>;
};

const { data: isLoginValid } = await Astro.callAction(
    actions.admin.isLoginValid,
    undefined,
);

const { showTitle = true, layout } = Astro.props;

if (!isLoginValid && layout) {
    layout.header = true;
    layout.footer = true;
}
---

<Layout
    title={Astro.props.title ?? "🤫"}
    header
    footer
    sideBar={isLoginValid
        ? [
              {
                  type: "link",
                  text: "仪表板",
                  route: "/admin",
                  isActive: Astro.url.pathname === "/admin",
              },
              { type: "divider" },
              //   { type: "subtitle", text: "管理后台" },
              {
                  type: "link",
                  text: "日志",
                  route: "/admin/logs",
              },
              {
                  type: "link",
                  text: "API 缓存",
                  route: "/admin/cache-api",
              },
              {
                  type: "link",
                  text: "图片缓存",
                  route: "/admin/cache-images",
              },
              { type: "divider" },
              //   { type: "subtitle", text: "信息图表" },
              //   {
              //       type: "link",
              //       text: "信息图表",
              //       route: "/admin/infographics",
              //   },
              //   { type: "divider" },
              { type: "subtitle", text: "全列表" },
              {
                  type: "link",
                  text: "挑战灾害",
                  route: "/admin/list-challenge-hazards",
              },
          ]
        : undefined}
    {...layout}
>
    {
        isLoginValid ? (
            <section class="main">
                {showTitle && <h1>{Astro.props.title}</h1>}
                <slot />
            </section>
        ) : (
            <section class="login">
                <h1>🤫</h1>
                <LoginForm client:idle />
                <ReGenCode client:idle />
            </section>
        )
    }
</Layout>

<style lang="less">
    @import "@/utils/mixins.less";

    .login {
        text-align: center;
        max-width: var(--body-safe-min-width);
        margin: 0 auto;
        flex: 1;
        display: flex;
        flex-flow: column nowrap;
        align-items: center;
        justify-content: center;
        padding: 4em 0;
        gap: 2em;

        h1 {
            font-size: 10em;
            margin: 0;
        }
    }

    .main {
        padding-bottom: 4em;
        & > h1 {
            margin: 0;
            padding: 1em 0 0.6667em 0;
            line-height: 1.2;
        }
    }
</style>

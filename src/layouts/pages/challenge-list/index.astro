---
import { actions, ActionError } from "astro:actions";

import { type ComponentProps } from "react";
import {
    urlPrefixSanityImageCdn,
    getChallengeCatalogPageLink,
    routeBase,
    aircraftTypeString,
    aircraftTypeStringShort,
} from "@/global";
import {
    type AircraftTypes,
    type ValidContentListAutoLoadMoreType,
} from "@/types";
import { CONTENT_LIST_AUTO_LOAD_MORE } from "@/constants/cookies";
import Layout from "@/layouts/layout.astro";
import ChallengeListGrid from "@/components/challenge-list-grid";

import { errorLog } from "@/utils/log";
import { page } from "dist/server/pages/_image.astro.mjs";

// ============================================================================
//
// MARK: Props
//
// ============================================================================

type Props = {
    /**
     * - 如果为 `filter`，为查询页，需在页面模板中自行实现数据查询方法
     */
    catalog: ComponentProps<typeof ChallengeListGrid>["catalog"];
    query?: string;
    error?: ActionError | null;
};

// ============================================================================
//
// MARK: Constants
//
// ============================================================================

const heroImage: Record<Props["catalog"], string> = {
    latest: "dc8c90a5e20183a9e3713e460593908e325a0170-2560x1440.png",
    filter: "956647eaa837008e04c2b5c690b42546d6c7eccc-2560x1440.png",

    bush: "e955577ad3939d29c3ffbc33a002cb99111bdd22-2560x1440.png",
    "luxury-private": "6098c0f600461bc27680128b8c321b169f3a6b8e-2560x1440.png",
    "small-commercial":
        "f1394f67799f573b24375aa9faf9fdff4ee7b0b8-2560x1440.png",
    "medium-commercial":
        "e985098d1b6c19b9704eb87dff9ebe5dcd409b4b-2560x1440.png",
    "business-jets": "8a5b4efc96e0447566140d00c5bcace603d53848-2560x1440.png",
    "large-narrow-body":
        "5d0f7d320d719d59ad974b8a5ba89b5b02efa464-2560x1440.png",
    "large-wide-body": "2d9a4f49126a181e19899072cf88c18b964fd9ba-2560x1440.png",
};
const exampleAircrafts: Record<Props["catalog"], string[]> = {
    latest: [],
    filter: [],

    bush: ["DHC-6“双水獭”", "塞斯纳 208"],
    "luxury-private": ["钻石 DA-42", "西瑞 VisionJet"],
    "small-commercial": ["皮拉图斯 PC-12"],
    "medium-commercial": ["ATR", "冲8"],
    "business-jets": ["塞斯纳奖状", "庞巴迪挑战者"],
    "large-narrow-body": ["空客 A320", "波音 737"],
    "large-wide-body": ["空客 A350", "波音 777"],
};

// ============================================================================
//
// MARK: Data
//
// ============================================================================

const length = 20;
const { data: initialList, error } =
    Astro.props.catalog === "filter"
        ? { data: { initialList: [], total: 0 } }
        : await Astro.callAction(actions.challengePage.fetchList, {
              length,
              sort: Astro.props.catalog === "latest" ? "latest" : "difficulty",
              types:
                  Astro.props.catalog === "latest"
                      ? undefined
                      : [Astro.props.catalog as AircraftTypes],
          });
if ((error && error.code === "NOT_FOUND") || !initialList) {
    if (error)
        errorLog(
            [
                `${Astro.originPathname} -> 404`,
                error.code,
                error.message,
                (error.cause as any)?.GROQ
                    ? `GROQ: "${(error.cause as any)?.GROQ.replace(/\n\s+/gm, " ")}"`
                    : "",
            ]
                .filter(Boolean)
                .join(" | "),
        );
    else
        errorLog(
            [`${Astro.originPathname} -> 404`, "No challenge list"]
                .filter(Boolean)
                .join(" | "),
        );
    return Astro.rewrite("/404");
}
if (error) {
    const err = error as unknown as ActionError;
    errorLog(
        [
            `${Astro.originPathname} -> 500`,
            err.code,
            err.message,
            (err.cause as any)?.GROQ
                ? `GROQ: "${(err.cause as any)?.GROQ.replace(/\n\s+/gm, " ")}"`
                : "",
        ]
            .filter(Boolean)
            .join(" | "),
    );
    Astro.response.status = 500;
    Astro.props.error = error;
    return Astro.rewrite("/500");
}

// console.log(initialList)

// ============================================================================
//
// MARK: 默认值
//
// ============================================================================

const pageTitle = {
    catalog: ["固定翼飞机", "着陆挑战"],
    name:
        Astro.props.catalog === "latest"
            ? "最新收录"
            : Astro.props.catalog === "filter"
              ? "查询 / 抽选"
              : aircraftTypeString[Astro.props.catalog as AircraftTypes],
};

// ============================================================================
//
// MARK: Astro Template
//
// ============================================================================
---

<Layout
    title={[pageTitle.catalog.join(""), pageTitle.name].join(" : ")}
    header
    footer
    sideBar={[
        {
            type: "link",
            text: "最新收录",
            route: routeBase.challenges,
            isActive: Astro.props.catalog === "latest",
        },
        ...(import.meta.env.DEV
            ? [
                  {
                      type: "link" as const,
                      text: "查询 / 抽选",
                      route: getChallengeCatalogPageLink("filter"),
                      isActive: Astro.props.catalog === "filter",
                  },
                  {
                      type: "link" as const,
                      text: "[DEV] 门户",
                      route: routeBase.challenges + "/portal",
                      isActive: false,
                  },
              ]
            : []),
        { type: "divider" },
        ...Object.entries(aircraftTypeStringShort).map(([key, value]) => {
            const route = getChallengeCatalogPageLink(key as AircraftTypes);
            return {
                type: "link" as const,
                text: value,
                subTexts: exampleAircrafts[key as Props["catalog"]],
                route,
                isActive: Astro.props.catalog === key,
            };
        }),
    ]}
>
    <section class="list">
        <section class="hero-image">
            <h2 class="title">
                <small>{pageTitle.catalog[0]}</small>{pageTitle.catalog[1]}
            </h2>
            <h1 class="title">{pageTitle.name}</h1>
            {
                Astro.props.catalog !== "filter" && (
                    <span class="total">
                        <strong>{initialList.total}</strong>
                        <small>已收录</small>
                    </span>
                )
            }
            <div class="image">
                <img
                    alt={[pageTitle.catalog.join(""), pageTitle.name].join(
                        " : ",
                    )}
                    src={`${urlPrefixSanityImageCdn}/${
                        heroImage[Astro.props.catalog]
                    }?fm=webp&w=1280&q=50`}
                    fetchpriority="high"
                />
            </div>
        </section>

        {
            Astro.props.catalog === "filter" ? (
                <slot />
            ) : Array.isArray(initialList.list) ? (
                <ChallengeListGrid
                    client:idle
                    catalog={Astro.props.catalog}
                    length={length}
                    initialList={initialList.list}
                    initialListIsComplete={
                        initialList.list.length >= initialList.total
                    }
                    infiniteScroll
                    defaultContentListAutoLoadMore={
                        Astro.cookies.get(CONTENT_LIST_AUTO_LOAD_MORE)
                            ?.value as ValidContentListAutoLoadMoreType
                    }
                    showAircraftTypes={["latest", "filter"].includes(
                        Astro.props.catalog,
                    )}
                />
            ) : null
        }
    </section>
</Layout>

<style lang="less">
    // ========================================================================
    //
    // MARK: LESS Module
    //
    // ========================================================================

    @import "@/utils/mixins.less";

    .list {
        --hero-image-height: 16em;
        --hero-image-bottom-offset-percentage: 30%;
        --hero-image-blur-from: 7em;
        --hero-image-blur-to: 33.3333%;
        --container-padding-top: 1.25em;
        padding-top: var(--container-padding-top);
        padding-bottom: 4em;
        .screen-lg({
            --hero-image-height: 14em;
        });
        .screen-md({
            --hero-image-height: 11.5em;
            --hero-image-blur-to: 66.6667%;
        });
        .screen-sm({
            --hero-image-height: 13em;
            --hero-image-blur-from: 5em;
            --hero-image-blur-to: 50%;
            --container-padding-top: 1.75em;
        });
    }

    .hero-image {
        position: relative;
        z-index: 1;
        height: var(--hero-image-height);
        background: var(--dark-theme-color);
        margin-bottom: 1em;
        background: no-repeat center/cover;
        border-radius: 0.5em;
        overflow: hidden;
        display: flex;
        flex-flow: column nowrap;
        align-items: flex-start;
        justify-content: flex-end;
        padding: 1em 1.5em;

        .image {
            &,
            & > img,
            &::before,
            &::after {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
            }
            z-index: 1;
            // background: no-repeat center/cover;
            pointer-events: none;
            // filter: saturate(150%);

            & > img {
                display: block;
                object-fit: cover;
            }

            &::before,
            &::after {
                content: "";
            }
            &::after {
                .pixel-dots-styles();
                z-index: 3;
                // pointer-events: none;
            }
            @supports (mask-image: linear-gradient(black, transparent)) {
                &::before {
                    z-index: 2;
                    mask-image: linear-gradient(
                        to right,
                        black var(--hero-image-blur-from),
                        transparent var(--hero-image-blur-to)
                    );
                    backdrop-filter: blur(var(--backdrop-filter-blur-value));
                    // &::after {
                    //     content: "";
                    //     position: absolute;
                    //     bottom: 0;
                    //     left: 0;
                    //     width: 100%;
                    //     height: 100%;
                    //     background: var(--dark-theme-color-p-30);
                    // }
                }
            }
        }

        .title,
        .total {
            display: block;
            z-index: 10;
            text-shadow: 0 0.1em 0.15em var(--dark-theme-color-p-80);
            color: var(--dark-text-color-primary);
        }
        h1,
        h2 {
            // position: absolute;
            // bottom: var(--hero-image-bottom-offset-percentage);
            // bottom: 0;
            margin: 0;
            letter-spacing: 0.15em;
            line-height: 1.2em;
            padding-bottom: calc((var(--global-header-height) - 1.2em) / 2);
            small {
                display: block;
                letter-spacing: 0.14em;
            }
        }
        .total {
            background: var(--dark-theme-color-p-60);
            border-radius: 10em;
            padding: 0 0.6667em;
            strong,
            small {
                display: inline-block;
            }
            strong {
                margin-right: 0.15em;
            }
        }
    }
</style>

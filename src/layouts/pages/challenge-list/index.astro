---
/*
TODO: Remember Options
DEFAULTS
    Categories: C+D
    Difficulty: 3+5+7
Trigger: COOKIE - RANDOM or CATALOG
*/

import { actions, ActionError } from "astro:actions";

import {
    urlPrefixSanityImageCdn,
    getChallengeCatalogPageLink,
    routeBase,
    aircraftTypeString,
    aircraftTypeStringShort,
} from "@/global";
import {
    type AircraftTypes,
    type ValidContentListAutoLoadMoreType,
} from "@/types";
import { CONTENT_LIST_AUTO_LOAD_MORE } from "@/constants/cookies";
import Layout from "@/layouts/layout.astro";
import Block from "@/components/block.astro";
import ChallengeListGrid from "@/components/challenge-list-grid";

import { errorLog } from "@/utils/log";

// #region Props ==============================================================

type Props = {
    catalog: "latest" | "filter" | AircraftTypes;
    error?: ActionError | null;
};

// #region Data ===============================================================

const length = 20;
const { data: initialList, error } = await Astro.callAction(
    actions.challengePage.fetchList,
    {
        length,
        sort: Astro.props.catalog === "latest" ? "latest" : "difficulty",
        types:
            Astro.props.catalog === "latest"
                ? undefined
                : Astro.props.catalog === "filter"
                  ? undefined
                  : [Astro.props.catalog as AircraftTypes],
    },
);
if ((error && error.code === "NOT_FOUND") || !initialList) {
    if (error)
        errorLog(
            [
                `${Astro.originPathname} -> 404`,
                error.code,
                error.message,
                (error.cause as any)?.GROQ
                    ? `GROQ: "${(error.cause as any)?.GROQ.replace(/\n\s+/gm, " ")}"`
                    : "",
            ]
                .filter(Boolean)
                .join(" | "),
        );
    else
        errorLog(
            [`${Astro.originPathname} -> 404`, "No challenge list"]
                .filter(Boolean)
                .join(" | "),
        );
    return Astro.rewrite("/404");
}
if (error) {
    const err = error as unknown as ActionError;
    errorLog(
        [
            `${Astro.originPathname} -> 500`,
            err.code,
            err.message,
            (err.cause as any)?.GROQ
                ? `GROQ: "${(err.cause as any)?.GROQ.replace(/\n\s+/gm, " ")}"`
                : "",
        ]
            .filter(Boolean)
            .join(" | "),
    );
    Astro.response.status = 500;
    Astro.props.error = error;
    return Astro.rewrite("/500");
}

// console.log(initialList)

// ============================================================================
---

<Layout
    title="固定翼飞机着陆挑战"
    header
    footer
    sideBar={[
        {
            type: "link",
            text: "最新收录",
            route: routeBase.challenges,
            isActive: Astro.props.catalog === "latest",
        },
        {
            type: "link",
            text: "查询 / 抽选",
            route: getChallengeCatalogPageLink("filter"),
            isActive: Astro.props.catalog === "filter",
        },
        ...(import.meta.env.DEV
            ? [
                  {
                      type: "link" as const,
                      text: "[DEV] 门户",
                      route: routeBase.challenges + "/portal",
                      isActive: false,
                  },
              ]
            : []),
        { type: "divider" },
        ...Object.entries(aircraftTypeStringShort).map(([key, value]) => {
            const route = getChallengeCatalogPageLink(key as AircraftTypes);
            return {
                type: "link" as const,
                text: value,
                route,
                isActive: Astro.props.catalog === key,
            };
        }),
    ]}
>
    <section class="list">
        <section class="hero-image">
            <h2 class="title">固定翼飞机着陆挑战</h2>
            <h1 class="title">
                {
                    Astro.props.catalog === "latest"
                        ? "最新收录"
                        : Astro.props.catalog === "filter"
                          ? "查询 / 抽选"
                          : aircraftTypeString[
                                Astro.props.catalog as AircraftTypes
                            ]
                }
            </h1>
            <span class="total">已收录 {initialList.total} 个挑战</span>
            <!-- <span
                class="image-container"
                style={{
                    backgroundImage: `url(${urlPrefixSanityImageCdn}/5d0f7d320d719d59ad974b8a5ba89b5b02efa464-2560x1440.png?auto=format&w=960&blur=100&q=60)`,
                }}
                ><span
                    class="image"
                    style={{
                        backgroundImage: `url(${urlPrefixSanityImageCdn}/5d0f7d320d719d59ad974b8a5ba89b5b02efa464-2560x1440.png?auto=format&w=1280&q=60)`,
                    }}></span></span
            > -->
            <span
                class="image-container"
                style={{
                    backgroundImage: `url(${urlPrefixSanityImageCdn}/5d0f7d320d719d59ad974b8a5ba89b5b02efa464-2560x1440.png?auto=format&w=1280&q=60)`,
                }}></span>
        </section>

        {
            Astro.props.catalog === "filter" ? (
                "TODO: FILTER"
            ) : (
                <ChallengeListGrid
                    client:idle
                    catalog={Astro.props.catalog}
                    length={length}
                    initialList={initialList.list}
                    initialListIsComplete={
                        initialList.list.length >= initialList.total
                    }
                    infiniteScroll
                    defaultContentListAutoLoadMore={
                        Astro.cookies.get(CONTENT_LIST_AUTO_LOAD_MORE)
                            ?.value as ValidContentListAutoLoadMoreType
                    }
                    showAircraftTypes={["latest", "filter"].includes(
                        Astro.props.catalog,
                    )}
                />
            )
        }
    </section>
</Layout>


---
import { actions } from "astro:actions";
import {
    type VideoListPageTypesType,
    type ValidContentListAutoLoadMoreType,
} from "@/types";
import { CONTENT_LIST_AUTO_LOAD_MORE } from "@/constants/cookies";
import {
    extraAviationKnowledgeTitle,
    getChallengeCatalogPageLink,
} from "@/global";

import VideoListGrid from "@/components/video-list-grid";
import ChallengeListHorizontal from "@/components/challenge-list-horizontal.tsx";
import Collection from "@/components/collection.astro";

type FilterType = {
    type?: VideoListPageTypesType;
    slug?: string;
};
type Props = FilterType & {
    isIndex: boolean;
    info: Awaited<ReturnType<typeof actions.videoListPage.fetchInfo>>["data"];
    extraFilters?: FilterType[];
};
const length = 20;
const extra: Parameters<typeof actions.videoListPage.fetchList>[0]["extra"] =
    [];

if (
    Astro.props.type &&
    ["aircraftFamily", "aircraftOnboardDevice"].includes(Astro.props.type)
) {
    /**
     * 追加请求的 GROQ
     *  - 追加到页面初始化请求中，即：不会有额外网络请求
     */
    function getExtraQueryString(_id: string) {
        return `*[_type=="video" && "tutorial" in tags[]->slug.current && references(${_id})] {
    _id,
    'slug': slug.current,
    title,
    release,
    "cover": cover.asset->path,
    'tags': tags[]->{
        _id,
        'slug': slug.current,
        "value": name,
        "name": title
    },
    links,
} | order(release desc)`;
    }

    if (
        Array.isArray(Astro.props.info?.onboard_devices) &&
        Astro.props.info.onboard_devices.length
    ) {
        Astro.props.info.onboard_devices.forEach(({ _id, maker, name }) => {
            extra.push({
                name: `机载设备 (${maker} ${name}) 教学`,
                query: getExtraQueryString(`"${_id}"`),
            });
        });
    }
    if (Array.isArray(Astro.props.info?.tags) && Astro.props.info.tags.length) {
        extra.push({
            name: extraAviationKnowledgeTitle,
            query: getExtraQueryString(
                `[${Astro.props.info.tags.map(({ _id }) => `"${_id}"`).join(",")}]`,
            ),
        });
    }
}

let requestFilters =
    Astro.props.type && Astro.props.slug
        ? [
              {
                  type: Astro.props.type,
                  slug: Astro.props.slug,
              },
          ]
        : undefined;
if (
    Array.isArray(requestFilters) &&
    Array.isArray(Astro.props.extraFilters) &&
    Astro.props.extraFilters.length
) {
    requestFilters = [
        ...requestFilters,
        ...Astro.props.extraFilters.map((filter) => ({
            type: filter.type!,
            slug: filter.slug!,
        })),
    ];
}
const { data, error: error } = await Astro.callAction(
    actions.videoListPage.fetchList,
    {
        filters: requestFilters,
        from: 0,
        length,
        extra: extra.length > 0 ? extra : undefined,
    },
);

type List = Exclude<typeof data, undefined>["list"];

if (error) {
    console.trace(error);
    Astro.response.status = 500;
    // Astro.response.statusText = (error.cause || error.message || "") as string;
    return Astro.rewrite("/500");
}
---

<section class="video-list">
    {
        !data ? (
            "暂无内容"
        ) : Astro.props.type === "aircraftFamily" ? (
            <>
                {Object.entries(
                    data.list.reduce(
                        (listByCategory, currentPost) => {
                            // 如果 `相关航空知识` 额外类别中包含该视频
                            // 则不在主要类别（如 `教程`）中显示
                            if (
                                Array.isArray(
                                    data?.[extraAviationKnowledgeTitle],
                                ) &&
                                data?.[extraAviationKnowledgeTitle].some(
                                    ({ _id }) => _id === currentPost._id,
                                )
                            )
                                return listByCategory;

                            if (!listByCategory[currentPost.tags[0]._id])
                                listByCategory[currentPost.tags[0]._id] = {
                                    name: currentPost.tags[0].name,
                                    slug: currentPost.tags[0].slug,
                                    list: [],
                                };
                            listByCategory[currentPost.tags[0]._id].list.push(
                                currentPost,
                            );
                            return listByCategory;
                        },
                        {
                            "a8c9106d-729d-4ef0-8856-2427033a3fb7": {
                                name: "教程攻略",
                                slug: "tutorial",
                                list: [],
                            },
                            "04d17ab0-b28e-4132-9418-3fc2b85bbf4f": {
                                name: "评测",
                                slug: "review",
                                list: [],
                            },
                            "acc16e01-9854-4270-9a13-1626c080a2e8": {
                                name: "飞行实况",
                                slug: "gameplay",
                                list: [],
                            },
                        } as {
                            [category: string]: {
                                name: string;
                                slug?: string;
                                list: List;
                            };
                        },
                    ),
                )
                    // .filter(
                    //     ([_id, { name, list }]) =>
                    //         Array.isArray(list) && list.length > 0
                    // )
                    .map(([_id, { name, list, slug }] /*, index, arr*/) => (
                        <Fragment>
                            {Array.isArray(list) && list.length > 0 && (
                                <Fragment>
                                    <h3>{name}</h3>
                                    <VideoListGrid
                                        type="aircraftFamily"
                                        initialList={list}
                                        initialListIsComplete
                                        showLoadMoreButton={false}
                                        tagPurpose={
                                            slug === "review"
                                                ? "review"
                                                : slug === "preview"
                                                  ? "preview"
                                                  : undefined
                                        }
                                    />
                                </Fragment>
                            )}
                            {/* 遍历到 `评测` 类别，追加请求结果中的 `extra` 内容 */}
                            {slug === "review" &&
                                extra.map(({ name }) =>
                                    Array.isArray(data[name]) &&
                                    data[name].length > 0 ? (
                                        <Fragment>
                                            <h3>{name}</h3>
                                            <VideoListGrid
                                                type="aircraftFamily"
                                                initialList={
                                                    name ===
                                                    extraAviationKnowledgeTitle
                                                        ? data[name]
                                                        : data[name].filter(
                                                              (post) =>
                                                                  data?.[
                                                                      extraAviationKnowledgeTitle
                                                                  ].every(
                                                                      ({
                                                                          _id,
                                                                      }) =>
                                                                          _id !==
                                                                          post._id,
                                                                  ),
                                                          )
                                                }
                                                initialListIsComplete
                                                showLoadMoreButton={false}
                                            />
                                        </Fragment>
                                    ) : null,
                                )}
                        </Fragment>
                    ))}
                {Array.isArray(Astro.props.info?.challenges) && (
                    <Collection
                        class="aircraft-family-challenges"
                        name="latest-challenges"
                        title="适合挑战"
                        route={getChallengeCatalogPageLink(
                            Astro.props.info?.types?.[0],
                        )}
                        showMore={`更多 (${Astro.props.info?.challenge_count} 已收录)`}
                        titleMore
                    >
                        <ChallengeListHorizontal
                            client:idle
                            challenges={Astro.props.info.challenges}
                        />
                    </Collection>
                )}
            </>
        ) : Astro.props.type === "aircraftOnboardDevice" ? (
            Object.entries(
                data.list.reduce(
                    (listByCategory, currentPost) => {
                        // 如果 `相关航空知识` 额外类别中包含该视频
                        // 则不在主要类别（如 `教程`）中显示
                        if (
                            Array.isArray(
                                data?.[extraAviationKnowledgeTitle],
                            ) &&
                            data?.[extraAviationKnowledgeTitle].some(
                                ({ _id }) => _id === currentPost._id,
                            )
                        )
                            return listByCategory;

                        if (!listByCategory[currentPost.tags[0]._id])
                            listByCategory["OTHER"].list.push(currentPost);
                        else
                            listByCategory[currentPost.tags[0]._id].list.push(
                                currentPost,
                            );
                        return listByCategory;
                    },
                    {
                        "a8c9106d-729d-4ef0-8856-2427033a3fb7": {
                            name: "教程攻略",
                            slug: "tutorial",
                            list: [],
                        },
                        OTHER: {
                            name: "其他视频",
                            slug: "",
                            list: [],
                        },
                    } as {
                        [category: string]: {
                            name: string;
                            slug?: string;
                            list: List;
                        };
                    },
                ),
            )
                // .filter(
                //     ([_id, { name, list }]) =>
                //         Array.isArray(list) && list.length > 0
                // )
                .map(([_id, { name, slug, list }] /*, index, arr*/) => (
                    <Fragment>
                        {Array.isArray(list) && list.length > 0 && (
                            <Fragment>
                                <h3>{name}</h3>
                                <VideoListGrid
                                    type="aircraftFamily"
                                    initialList={list}
                                    initialListIsComplete
                                    showLoadMoreButton={false}
                                    tagPurpose={
                                        name === "教程攻略"
                                            ? undefined
                                            : "latest"
                                    }
                                    allowAssetPriorityHigh
                                />
                            </Fragment>
                        )}
                        {/* 遍历到 `评测` 类别，追加请求结果中的 `extra` 内容 */}
                        {slug === "tutorial" &&
                            extra.map(({ name }) =>
                                Array.isArray(data[name]) &&
                                data[name].length > 0 ? (
                                    <Fragment>
                                        <h3>{name}</h3>
                                        <VideoListGrid
                                            type="aircraftFamily"
                                            initialList={data[name]}
                                            initialListIsComplete
                                            showLoadMoreButton={false}
                                            allowAssetPriorityHigh
                                        />
                                    </Fragment>
                                ) : null,
                            )}
                    </Fragment>
                ))
        ) : (
            <VideoListGrid
                client:idle
                type={Astro.props.type}
                slug={Astro.props.slug}
                isIndex={Astro.props.isIndex}
                length={length}
                initialList={data.list}
                initialListIsComplete={data.list.length >= data.total}
                infiniteScroll
                defaultContentListAutoLoadMore={
                    Astro.cookies.get(CONTENT_LIST_AUTO_LOAD_MORE)
                        ?.value as ValidContentListAutoLoadMoreType
                }
            />
        )
    }
</section>

<style lang="less">
    @import "@/utils/mixins.less";

    .video-list {
        h3 {
            margin-top: 1em;
            margin-bottom: 0.6667em;
        }
        h3 ~ h3 {
            margin-top: 2em;
        }
        &:has(> h3) {
            margin-top: 1.3333em;
        }

        .aircraft-family-challenges {
            margin-top: 3em;
            margin-bottom: 0.6667em;
        }
    }
</style>

---
import { navLinks } from "@/global";

import HomeHollow from "@/assets/svg-symbols/home-hollow.svg";
import HomeFill from "@/assets/svg-symbols/home-fill.svg";
import VideosHollow from "@/assets/svg-symbols/videos-hollow.svg";
import VideosFill from "@/assets/svg-symbols/videos-fill.svg";
import LivestreamHollow from "@/assets/svg-symbols/livestream-hollow.svg";
import LivestreamFill from "@/assets/svg-symbols/livestream-fill.svg";
import ChallengesHollow from "@/assets/svg-symbols/challenges-hollow.svg";
import ChallengesFill from "@/assets/svg-symbols/challenges-fill.svg";

import isRouteActive from "@/utils/is-route-active";

type Props = {
    header: boolean;
    originPathname: string;
};
---

{
    Astro.props.header && (
        <section class="navbar">
            <div class="wrapper">
                {navLinks.map(({ key, route, name, extraChecks }) => {
                    const isActive = isRouteActive(
                        route,
                        Astro.originPathname,
                        extraChecks
                    );
                    return (
                        <a
                            href={route}
                            class:list={[
                                "link",
                                {
                                    "is-active": isActive,
                                },
                            ]}
                        >
                            <span class="icon">
                                {key === "home" ? (
                                    isActive ? (
                                        <HomeFill />
                                    ) : (
                                        <HomeHollow />
                                    )
                                ) : key === "videos" ? (
                                    isActive ? (
                                        <VideosFill />
                                    ) : (
                                        <VideosHollow />
                                    )
                                ) : key === "live" ? (
                                    isActive ? (
                                        <LivestreamFill />
                                    ) : (
                                        <LivestreamHollow />
                                    )
                                ) : key === "challenges" ? (
                                    isActive ? (
                                        <ChallengesFill />
                                    ) : (
                                        <ChallengesHollow />
                                    )
                                ) : null}
                            </span>
                            {name}
                        </a>
                    );
                })}
            </div>
        </section>
    )
}

<style lang="less">
    @import "@/utils/mixins.less";

    .navbar {
        --icon-size: 25px;

        position: fixed;
        bottom: 0;
        width: 100%;
        z-index: var(--global-header-z-index);
        flex: none;
        display: none;
        padding-top: var(--global-small-screen-navbar-bottom-edge);
        padding-bottom: calc(
            var(--global-bottom-safe-distance) +
                var(--global-small-screen-navbar-bottom-edge)
        );
        padding-left: calc(var(--global-edge-safe-distance) * 1.5);
        padding-right: calc(var(--global-edge-safe-distance) * 1.5);
        background: linear-gradient(
            to top,
            var(--theme-color-p-90),
            var(--theme-color-p-60) 50%,
            rgba(255, 255, 255, 0)
        );

        .screen-sm({
            display: block;
        });

        & > .wrapper {
            display: flex;
            flex-flow: row nowrap;
            justify-content: space-around;
            align-items: center;
            height: var(--global-small-screen-navbar-height);
            padding: 0 calc(var(--global-small-screen-navbar-height) * 0.25);
            text-align: center;
            color: var(--text-color-secondary);
            border: 1px solid var(--border-color);
            border-radius: var(--global-small-screen-navbar-height);
            background-color: var(
                --global-small-screen-navbar-background-color
            );
            backdrop-filter: var(--global-header-backdrop-filter);
            box-shadow: var(--overlay-box-shadow);
            .font-size-clamp-with-line-height(unit((12 / 0.85), px), unit((1 * 12 / 0.85), px));
        }

        .link {
            display: block;
            position: relative;
            text-decoration: none;
            flex: 1;
            line-height: 1.2;
            .icon {
                display: block;
                width: var(--icon-size);
                height: var(--icon-size);
                margin: 0 auto 0.15em auto;
                color: inherit;
                transition: inherit;
                transition-property: color, background-color;
                svg {
                    transition: inherit;
                    transition-property: color, fill;
                    display: block;
                    width: var(--icon-size);
                    height: var(--icon-size);
                    object-fit: contain;
                }
                &:empty {
                    background: var(--tag-background-color);
                    border-radius: 0.3333em;
                }
            }
            &.is-active {
                color: var(--text-color-primary);
                .icon:empty {
                    background-color: var(--text-color-secondary);
                }
            }
        }
    }
</style>

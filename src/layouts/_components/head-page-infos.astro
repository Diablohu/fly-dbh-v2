---
import { type ValidPageContentType } from "@/types";
import { title as siteTitle, slogan, urlPrefixSanityImageCdn } from "@/global";
import getPageTitle from "@/utils/get-page-title";
import getSanityImageUrl from "@/utils/get-sanity-image-url";
import { undefined } from "astro:schema";

type Props = {
    title?: string;
    type?: ValidPageContentType;
    /**
     * 头部 Meta 信息 `keyword`
     * - 默认为兜底文字
     */
    keywords?: string;
    /**
     * 头部 Meta 信息 `description`
     * - 默认无内容
     */
    description?: string;
    /** 用于社交分享 */
    image?: string | URL;
    imageWidth?: number;
    imageHeight?: number;
};
const {
    title = siteTitle,
    keywords = "fly-simming, fly-sim, 飞行模拟, 飞行模拟器, 模拟飞行, 模拟飞行教程, 飞行模拟器教程, 飞行模拟器插件, 飞行模拟器飞机, 飞行模拟器机场, 飞行模拟器教学",
    description = slogan,
} = Astro.props;

let image = "";
if (Astro.props.image instanceof URL) {
    image = new URL(
        getSanityImageUrl(
            Astro.props.image,
            {
                fm: "auto",
                w: 960,
                q: 60,
            },
            [],
            { filenameIsValidUrl: true },
        ),
        Astro.url.origin,
    ).href;
} else if (Astro.props.image) {
    let isValidUrl = false;

    try {
        const url = new URL(Astro.props.image);
        image = Astro.props.image;
        isValidUrl = true;
    } catch (e) {}

    // 如果是以 `urlPrefixSanityImageCdn` 开头
    // 或不以 "/" 开头同时也不是合法 URL
    // 如果判断通过，判断为 Sanity 图片文件名
    if (
        new RegExp(`^${urlPrefixSanityImageCdn}\/`).test(Astro.props.image) ||
        (!isValidUrl && !/^\//.test(Astro.props.image))
    ) {
        image = new URL(
            getSanityImageUrl(
                Astro.props.image,
                {
                    fm: "auto",
                    w: 960,
                    q: 60,
                },
                [],
                { filenameIsValidUrl: isValidUrl },
            ),
            Astro.url.origin,
        ).href;
    }
}

const url = Astro.url;
url.protocol = "https:";
---

<Fragment>
    <title>{getPageTitle(title)}</title>
    {
        description && (
            <>
                <meta name="description" content={description} />
                <meta itemprop="description" content={description} />
            </>
        )
    }
    {keywords && <meta name="keywords" content={keywords} />}
    {
        image && (
            <>
                <link rel="image_src" href={image} />
                <link itemprop="thumbnailUrl" href={image} />
            </>
        )
    }
    <link itemprop="url" href={url.href} />
    <meta itemprop="name" content={title} />

    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:site_name" content={[siteTitle, slogan].join(" ")} />
    <meta property="og:title" content={title ?? siteTitle} />
    <meta
        property="og:type"
        content={Astro.props.type === "video-player"
            ? "video.other"
            : Astro.props.type === "article"
              ? "article"
              : Astro.props.type === "profile"
                ? "profile"
                : "website"}
    />
    {description && <meta property="og:description" content={description} />}
    {
        image && (
            <>
                <meta property="og:image" content={image} />
                {Astro.props.imageWidth && (
                    <meta
                        property="og:image:width"
                        content={Astro.props.imageWidth + ""}
                    />
                )}
                {Astro.props.imageHeight && (
                    <meta
                        property="og:image:height"
                        content={Astro.props.imageHeight + ""}
                    />
                )}
            </>
        )
    }

    <meta name="twitter:url" content={Astro.url.href} />
    <meta name="twitter:title" content={title ?? siteTitle} />
    {description && <meta name="twitter:description" content={description} />}
    {image && <meta name="twitter:image" content={image} />}
</Fragment>

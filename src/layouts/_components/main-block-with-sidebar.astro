---
import Block from "@/components/block.astro";

type Props = {
    sideBar?: Array<
        | "divider"
        | {
              type: "subtitle";
              text: string;
          }
        | {
              type: "link";
              text: string;
              route?: string;
              level?: number;
              isActive?: boolean;
              iconHtml?: string;
              iconHtmlActive?: string;
          }
        | {
              type: "button";
              text: string;
              level?: number;
              isActive?: boolean;
              slot?: any;
          }
    >;
};
---

<Block class="main-block-with-sidebar">
    <section class="main-block-with-sidebar-container">
        <section class="main"><slot /></section>
        <aside class="sidebar"></aside>
    </section>
</Block>

<style lang="less">
    @import "@/utils/mixins.less";

    .main-block-with-sidebar {
        .main-block-with-sidebar-container {
            display: flex;
            flex-flow: row nowrap;
            align-items: flex-start;
            gap: 1em;

            .main {
                flex: 1;
                order: 2;
            }
        }
    }
</style>

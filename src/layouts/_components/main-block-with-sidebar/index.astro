---
import { MAIN_BLOCK_WITH_SIDEBAR_SIDE_SWITCH_SMALL_SCREEN } from "@/constants/element-ids";

import ArrowLeftSvg from "@/assets/arrow/left3.svg";
import ArrowRightSvg from "@/assets/arrow/right3.svg";

import ClientInit from "./client-init";
import Item from "./sidebar-item.astro";

export type Props = {
    items?: Array<
        | { type: "divider" }
        | {
              type: "subtitle";
              text: string;
          }
        | {
              type: "link";
              text: string;
              route: string;
              level?: number;
              isActive?: boolean;
              iconHtml?: string;
              iconHtmlActive?: string;
          }
        | {
              type: "button";
              text: string;
              level?: number;
              isActive?: boolean;
          }
    >;
};
---

<div class="main-block-with-sidebar">
    <section class="main-block-with-sidebar-container">
        <section class="main"><slot /></section>
        <aside class="sidebar">
            <input
                id={MAIN_BLOCK_WITH_SIDEBAR_SIDE_SWITCH_SMALL_SCREEN}
                type="checkbox"
            />
            <section class="wrapper">
                <label
                    for={MAIN_BLOCK_WITH_SIDEBAR_SIDE_SWITCH_SMALL_SCREEN}
                    class="screen-sm-button-collapse-categories"
                    ><ArrowLeftSvg />收起分类</label
                >
                {Astro.props.items?.map((item) => <Item {...item} />)}
                <slot name="sidebar-extra-items" />
                <ClientInit client:load />
            </section>
            <label
                for={MAIN_BLOCK_WITH_SIDEBAR_SIDE_SWITCH_SMALL_SCREEN}
                class="screen-sm-categories-background"></label>
            <label
                for={MAIN_BLOCK_WITH_SIDEBAR_SIDE_SWITCH_SMALL_SCREEN}
                class="screen-sm-button-expand-categories"
                ><ArrowRightSvg />展开分类</label
            >
        </aside>
    </section>
</div>

<style lang="less">
    @import "@/utils/mixins.less";

    .main-block-with-sidebar {
        .block-component-styles();
        & > .main-block-with-sidebar-container {
            .block-wrapper-component-styles();
            display: flex;
            flex-flow: row nowrap;
            align-items: flex-start;
            gap: var(--global-edge-safe-distance);
        }
    }

    .main {
        flex: 1;
        order: 2;
    }

    // 所有以 `.screen-sm-` 开头的 class，均为小屏幕特别覆盖
    // 小屏幕时，类别导航自动隐藏，需要手动展开显示
    aside.sidebar {
        & > input[type="checkbox"] {
            display: none;
            position: absolute;
            top: 0;
            left: 0;
            width: 0;
            height: 0;
            overflow: hidden;
            z-index: -1;
            &:checked {
                & ~ .wrapper,
                & ~ .screen-sm-categories-background {
                    pointer-events: all;
                }
                & ~ .wrapper {
                    transform: none;
                    box-shadow: var(--overlay-box-shadow);
                }
                & ~ .screen-sm-categories-background {
                    opacity: 1;
                }
            }
        }

        --item-min-height: 2.5em;
        --item-line-height: 1.1em;
        --item-gap: 0.25em;
        --item-sub-text-color: var(--text-color-secondary);

        --layout-aside-link-item-no-icon-line-color: var(--border-color);
        --layout-aside-link-item-no-icon-line-color: color-mix(
            in hsl,
            var(--theme-color),
            var(--text-color-primary) 25%
        );

        position: sticky;
        top: calc(var(--global-sticky-top) + 0.5em);
        // top: var(--global-sticky-top);
        flex: 0 0 var(--global-sidebar-width);
        margin: 0.5em 0 4em 0;
        // border-radius: 10px;
        overflow: hidden;
        z-index: calc(var(--global-footer-z-index) + 1);
        overscroll-behavior: contain;

        & > .wrapper {
            position: relative;
            z-index: 5;
            height: 100%;
            overflow: auto;
            max-height: calc(100dvh - var(--global-sticky-top) - 1em);
            padding: 0 1em 0 0;
            overscroll-behavior: contain;
            scrollbar-width: thin;
            // background: #800;
            // scrollbar-width: none;
            // &:hover {
            //     scrollbar-width: thin;
            // }

            &::before,
            &::after {
                content: "";
                position: sticky;
                display: block;
                z-index: 5;
                left: 0;
                width: 100%;
                height: calc(var(--item-gap) * 2);
            }
            &::before {
                top: 0;
                // margin-bottom: calc(var(--item-gap) * 2);
                background: linear-gradient(
                    to bottom,
                    var(--theme-color) 0%,
                    transparent
                );
            }
            &::after {
                bottom: 0;
                margin-top: calc(var(--item-gap) * 2);
                background: linear-gradient(
                    to top,
                    var(--theme-color) 0%,
                    transparent
                );
            }

            & > :global(.item),
            & > .screen-sm-button-collapse-categories,
            & > :global(hr) {
                display: block;
            }
            & > :global(.item),
            & > .screen-sm-button-collapse-categories {
                position: relative;
                color: inherit;
                font-weight: normal;
                min-height: var(--item-min-height);
                line-height: var(--item-line-height);
                padding: calc(
                        (var(--item-min-height) - var(--item-line-height)) / 2
                    )
                    var(--layout-aside-link-item-padding-x);
                border-radius: 8px;
                & > :global(svg) {
                    position: absolute;
                    display: block;
                    width: var(--layout-aside-link-item-icon-size);
                    height: var(--layout-aside-link-item-icon-size);
                    top: 50%;
                    margin-left: calc(
                        var(--layout-aside-link-item-icon-size) * -1 -
                            var(--layout-aside-link-item-icon-margin)
                    );
                    margin-right: calc(
                        var(--layout-aside-link-item-icon-margin) / 2
                    );
                    margin-top: calc(
                        var(--layout-aside-link-item-icon-size) * -0.5
                    );
                    color: var(--text-color-secondary);
                    &.right-arrow {
                        --layout-aside-link-item-icon-size: 0.75em;
                        position: relative;
                        top: 0.225em;
                        margin: auto;
                        display: inline-block;
                        vertical-align: top;
                        margin-left: calc(
                            var(--layout-aside-link-item-icon-margin) / 2
                        );
                        // color: var(--text-color-secondary);
                    }
                }
                & + :global(.item) {
                    margin-top: var(--item-gap);
                }
            }
            & > :global(button.item) {
                appearance: none;
            }
            & > :global(.item.link),
            & > :global(.item.button),
            & > :global(button.item) {
                color: var(--text-color-primary);
                transition-property: transform, background-color;
                padding-left: var(
                    --layout-aside-link-item-with-icon-padding-left
                );
                .styles-hover() {
                    --item-sub-text-color: var(--text-color-primary);
                    background: var(--tag-background-color);
                }
                &.is-active,
                &:has(.is-menu-open) {
                    .styles-hover();
                }
                .pointer-hover(.styles-hover());
                &::before {
                    position: absolute;
                    top: calc(
                        (
                                var(--item-min-height) -
                                    var(
                                        --layout-aside-link-item-no-icon-dot-size
                                    )
                            ) /
                            2
                    );
                    // top: 50%;
                    left: calc(
                        var(--layout-aside-link-item-with-icon-padding-left) /
                            2 - var(--layout-aside-link-item-no-icon-dot-size) /
                            2
                    );
                    // margin-top: calc(
                    //     var(--layout-aside-link-item-no-icon-dot-size) / -2
                    // );
                    width: var(--layout-aside-link-item-no-icon-dot-size);
                    height: var(--layout-aside-link-item-no-icon-dot-size);
                    background: transparent;
                    border: var(
                            --layout-aside-link-item-no-icon-dot-border-width
                        )
                        solid var(--layout-aside-link-item-no-icon-line-color);
                    border-radius: 100%;
                    transition: inherit;
                    transition-property: border-color, background-color;
                }
                &:not(:has(> svg))::before,
                &:has(> svg.right-arrow)::before {
                    content: "";
                }
                & > :global(.sub-text) {
                    display: block;
                    // margin-left: -1.75em;
                    margin-top: 0.3333em;
                    color: var(--item-sub-text-color);
                    transition: var(--base-transition-duration);
                    transition-property: color;
                    & + :global(.sub-text) {
                        margin-top: 0.1333em;
                    }
                }
            }
            & > :global(.item.link) {
                text-decoration: none;
                &.is-active {
                    &::before {
                        // background-color: var(--accent-color-purple);
                        border-color: var(--text-color-secondary);
                        background-color: var(--text-color-secondary);
                    }
                    & > :global(svg) {
                        color: var(--text-color-primary);
                    }
                }
                &.is-level-2 {
                    &::after {
                        position: absolute;
                        content: "";
                        left: calc(
                            var(
                                    --layout-aside-link-item-with-icon-padding-left
                                ) /
                                2 -
                                var(
                                    --layout-aside-link-item-no-icon-dot-border-width
                                ) /
                                2
                        );
                        top: calc(var(--item-gap) * -1);
                        bottom: calc(
                            50% +
                                var(--layout-aside-link-item-no-icon-dot-size) /
                                2
                        );
                        width: var(
                            --layout-aside-link-item-no-icon-dot-border-width
                        );
                        background: var(
                            --layout-aside-link-item-no-icon-line-color
                        );
                        transition: inherit;
                        transition-property: background-color;
                    }
                    & + :global(.is-level-2) {
                        &::after {
                            top: calc(
                                -50% +
                                    var(
                                        --layout-aside-link-item-no-icon-dot-border-width
                                    )
                            );
                        }
                    }
                }
                /*
                    &.is-level-2 {
                        --line-left-edge: calc(
                            var(--layout-aside-link-item-icon-size) - var(--layout-aside-link-item-icon-margin) * 1 / 4
                        );
                        --line-width: 2px;
                        --line-border-radius: 0;
                        --line-horizontal-width: 0.6667em;
                        --line-horizontal-box-height: calc(
                            50% + var(--item-gap) / 2
                        );
                        // margin-left: calc(
                        //     var(--layout-aside-link-item-icon-size) + var(--layout-aside-link-item-icon-margin)
                        // );
                        // padding-left: var(--layout-aside-link-item-icon-margin);
                        &::before,
                        &::after {
                            content: "";
                            position: absolute;
                            border: 0px solid var(--layout-aside-link-item-no-icon-line-color);
                            border-bottom-left-radius: var(
                                --line-border-radius
                            );
                        }
                        &::before {
                            width: calc(
                                var(--line-horizontal-width) + var(--line-width)
                            );
                            left: var(--line-left-edge);
                            top: 0;
                            bottom: 0;
                            border-left-width: var(--line-width);
                        }
                        &::after {
                            width: var(--line-horizontal-width);
                            top: 0;
                            left: calc(
                                var(--line-left-edge) + var(--line-width)
                            );
                            height: var(--line-horizontal-box-height);
                            border-bottom-width: var(--line-width);
                        }
                        // --layout-aside-link-item-padding-left-extra: 1em;
                        & + .is-level-2 {
                            &::before {
                                top: calc(var(--item-gap) * -1);
                            }
                        }
                        &:not(:has(+ .is-level-2)) {
                            --line-border-radius: 0.5em;
                            &::before {
                                height: calc(
                                    var(--line-horizontal-box-height) +
                                        var(--item-gap)
                                );
                                bottom: auto;
                                border-bottom-width: var(--line-width);
                            }
                            &::after {
                                display: none;
                            }
                        }
                    }
                    */
            }
            & > :global(.item.button),
            & > :global(button.item) {
                appearance: none;
                width: 100%;
                text-align: left;
                border: 0;
                background: transparent;
                &.is-active {
                    &::before {
                        // background-color: var(--accent-color);
                        background-color: var(--text-color-secondary);
                        border-color: var(--text-color-secondary);
                    }
                }
                // &[data-explore="aircraftFamily"].is-active {
                //     &::before {
                //         background-color: var(--accent-color-teal);
                //     }
                // }
                // &:has([class*="is-status-loading"]) {
                //     pointer-events: none;
                // }
            }
            & > :global(hr) {
                margin: 0.6667em auto;
                border-top-width: 0;
            }
            & > .screen-sm-button-collapse-categories {
                cursor: pointer;
                transition: color var(--base-transition-duration);
                display: none;
                padding-left: var(
                    --layout-aside-link-item-with-icon-padding-left
                );
                margin-bottom: 1.3333em;
                &::after {
                    content: "";
                    position: absolute;
                    bottom: -0.6667em;
                    height: 1px;
                    left: 0;
                    right: 0;
                    background: var(--border-color);
                }
                & > :global(svg) {
                    --layout-aside-link-item-icon-size: 1em;
                }
                &:hover {
                    color: var(--text-color-primary);
                }
            }
        }

        & > .screen-sm-categories-background,
        & > .screen-sm-button-expand-categories {
            display: none;
            backdrop-filter: var(--global-header-backdrop-filter);
        }
        & > .screen-sm-categories-background {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            overflow: auto;
            overscroll-behavior: contain;
            scrollbar-width: none;
            background-color: var(--global-header-background-color);
            backdrop-filter: var(--global-header-backdrop-filter);
            transition: opacity var(--base-transition-duration) allow-discrete;
            opacity: 0;
            pointer-events: none;
            &::before {
                content: "";
                position: relative;
                display: block;
                top: 0;
                height: 200vh;
            }
        }
        & > .screen-sm-button-expand-categories {
            --size: 1.13333em;
            position: fixed;
            top: calc(var(--global-sticky-top) + 0.6667em);
            left: 0;
            display: none;
            // top: 1em;
            // left: var(--global-edge-safe-distance);
            // width: var(--size);
            // height: var(--size);
            border-radius: 0 100em 100em 0;
            cursor: pointer;
            font-weight: normal;
            padding: 0.3333em var(--global-edge-safe-distance);
            margin: 0 0 0.6667em 0;
            color: var(--text-color-secondary);
            background: var(--tag-background-color);
            transition: background-color var(--base-transition-duration);
            border: 1px solid var(--border-color);
            border-left: 0;
            box-shadow: var(--overlay-box-shadow);
            & > svg {
                position: relative;
                display: inline-block;
                vertical-align: top;
                width: var(--size);
                height: var(--size);
                margin-right: 0.3333em;
                top: 0.15em;
            }
            &:hover {
                background: var(--menu-background-color-highlight);
            }
            &::after {
                content: "";
                position: absolute;
                z-index: -1;
                top: -1px;
                bottom: -1px;
                left: 0;
                right: -1px;
                // border: inherit;
                border-radius: inherit;
                background: var(--global-header-background-color);
            }
            // &::before {
            //     content: "";
            //     position: absolute;
            //     z-index: 2;
            //     top: 0.5em;
            //     bottom: 0.5em;
            //     left: 2.5em;
            //     width: 2.5px;
            //     background: currentColor;
            // }
        }

        .screen-sm({
            position: fixed;
            width: auto;
            height: auto;
            left: auto;
            top: auto;
            overflow: visible;
            flex: none;
            // margin-right: -1em;
            & > .wrapper,
            & > .screen-sm-categories-background {
                position: fixed;
                left: 0;
                top: var(--global-sticky-top);
                height: calc(100% - var(--global-sticky-top));
                height: calc(100vh - var(--global-sticky-top));
                height: calc(100dvh - var(--global-sticky-top));
            }
            & > .wrapper, {
                &::before,
                &::after {
                    display: none;
                }
                min-width: var(--global-sidebar-width);
                width: 50vw;
                width: 50dvw;
                padding-top: calc(var(--global-edge-safe-distance) / 2);
                padding-left: var(--global-edge-safe-distance);
                padding-right: var(--global-edge-safe-distance);
                padding-bottom: calc(
                    var(--global-small-screen-navbar-height) +
                    var(--global-small-screen-navbar-bottom-edge) * 3 + 
                    var(--global-bottom-safe-distance)
                );
                max-height: none;
                overflow: auto;
                transform: translateX(-100%);
                transition: none var(--base-transition-duration) allow-discrete;
                transition-property: transform, opacity, box-shadow;
                background: var(--theme-color);
                pointer-events: none;
                & > .screen-sm-button-collapse-categories {
                    display: block;
                }
            }
            & > .screen-sm-categories-background,
            & > .screen-sm-button-expand-categories {
                display: block;
            }
        });
    }
</style>

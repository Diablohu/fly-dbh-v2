{
    "name": "fly-dbh-v2",
    "type": "module",
    "version": "0.0.1",
    "scripts": {
        "start": "node ./start.mjs",
        "dev": "astro dev --host --allowed-hosts local-dev.fly-dbh.com",
        "dev:local-assets-server": "cross-env FLYDBH_ASSETS_SERVER=local npm run dev",
        "build": "astro build",
        "build:next": "cross-env FLYDBH_BUILD_MODE=next astro build --mode=next",
        "analyze": "cross-env FLYDBH_BUILD_MODE=analyze npm run build && npx --yes open-cli dist/client/stats.html",
        "preview": "astro preview --host --allowed-hosts local-dev.fly-dbh.com",
        "check": "astro check",
        "astro": "astro",
        "astro:upgrade": "npx @astrojs/upgrade",
        "test": "vitest",
        "up": "npm run astro:upgrade && npx --yes npm-check-updates -i"
    },
    "dependencies": {
        "@astrojs/node": "^9.5.2",
        "@astrojs/react": "^4.4.2",
        "@astrojs/rss": "^4.0.15",
        "@astrojs/sitemap": "^3.7.0",
        "@microsoft/fetch-event-source": "^2.0.1",
        "@nanostores/react": "^1.0.0",
        "@oslojs/otp": "^1.1.0",
        "@react-oauth/google": "^0.13.4",
        "@sanity/client": "^7.14.1",
        "@sanity/image-url": "^2.0.3",
        "@splendidlabz/astro": "^5.4.0",
        "astro": "^5.17.1",
        "astro-portabletext": "^0.13.0",
        "axios": "^1.13.4",
        "cache-manager": "^7.2.8",
        "classnames": "^2.5.1",
        "colorthief": "^2.6.0",
        "dayjs": "^1.11.19",
        "debug": "^4.4.3",
        "dotenv": "^17.2.3",
        "fs-extra": "^11.3.3",
        "glob": "^13.0.1",
        "history": "^5.3.0",
        "isomorphic-dompurify": "^2.35.0",
        "less": "^4.5.1",
        "marked": "^17.0.1",
        "md5": "^2.3.0",
        "nanostores": "^1.1.0",
        "normalize.css": "^8.0.1",
        "numeral": "^2.0.6",
        "qrcode": "^1.5.4",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-dropzone": "^14.4.0",
        "react-inlinesvg": "^4.2.0",
        "react-is": "^19.2.4",
        "styled-components": "^6.3.8",
        "toastify-js": "^1.12.0",
        "viewerjs": "^1.11.7",
        "winston": "^3.19.0",
        "winston-daily-rotate-file": "^5.0.0"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.6",
        "@inquirer/prompts": "^8.2.0",
        "@types/express": "^5.0.6",
        "@types/fs-extra": "^11.0.4",
        "@types/less": "^3.0.8",
        "@types/md5": "^2.3.6",
        "@types/node": "^22.15.29",
        "@types/numeral": "^2.0.5",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^19.2.10",
        "@types/react-dom": "^19.2.3",
        "@types/toastify-js": "^1.12.4",
        "cross-env": "^10.1.0",
        "npm-run-script": "^0.0.4",
        "rollup-plugin-visualizer": "^6.0.5",
        "typescript": "^5.9.3",
        "vite-plugin-static-copy": "^3.2.0",
        "vitest": "^4.0.18"
    }
}

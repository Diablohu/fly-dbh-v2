{
    "name": "fly-dbh-v2",
    "type": "module",
    "private": true,
    "version": "0.0.1",
    "license": "GPL-3.0-only",
    "homepage": "https://fly-dbh.com",
    "bugs": {
        "url": "https://github.com/Diablohu/fly-dbh-v2/issues"
    },
    "scripts": {
        "start": "node ./start.mjs",
        "dev": "astro dev --host --allowed-hosts local-dev.fly-dbh.com",
        "dev:local-assets-server": "cross-env FLYDBH_ASSETS_SERVER=local npm run dev",
        "build": "astro build",
        "build:next": "cross-env FLYDBH_BUILD_MODE=next astro build --mode=next",
        "analyze": "cross-env FLYDBH_BUILD_MODE=analyze npm run build && npx --yes open-cli dist/client/stats.html",
        "preview": "astro preview --host --allowed-hosts local-dev.fly-dbh.com",
        "preview:next": "cross-env FLYDBH_BUILD_MODE=next astro preview --host --allowed-hosts local-dev.fly-dbh.com",
        "astro": "astro",
        "astro:check": "astro check",
        "astro:upgrade": "npx @astrojs/upgrade",
        "test": "vitest watch",
        "up": "npm run astro:upgrade && npx --yes npm-check-updates -i --format group"
    },
    "dependencies": {
        "@astrojs/node": "^11.1.6",
        "@astrojs/react": "^7.0.0",
        "@astrojs/rss": "^4.0.19",
        "@astrojs/sitemap": "^3.7.4",
        "@microsoft/fetch-event-source": "^2.0.1",
        "@nanostores/react": "^2.0.1",
        "@oslojs/otp": "^1.1.0",
        "@react-oauth/google": "^0.13.5",
        "@sanity/client": "^8.7.0",
        "@sanity/image-url": "^2.1.1",
        "astro": "^7.3.5",
        "astro-portabletext": "^1.0.1",
        "axios": "^1.20.0",
        "cache-manager": "^7.2.9",
        "classnames": "^2.5.1",
        "colorthief": "^3.5.0",
        "dayjs": "^1.11.23",
        "debug": "^4.4.3",
        "dotenv": "^18.0.3",
        "fs-extra": "^11.4.1",
        "glob": "^13.0.6",
        "history": "^5.3.0",
        "isomorphic-dompurify": "^4.3.0",
        "less": "^4.9.1",
        "marked": "^18.0.14",
        "md5": "^2.3.0",
        "nanostores": "^1.5.3",
        "normalize.css": "^8.0.1",
        "numeral": "^2.0.6",
        "qrcode": "^1.5.4",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-dropzone": "^20.1.2",
        "react-inlinesvg": "^4.5.0",
        "react-is": "^19.3.0",
        "styled-components": "^6.5.3",
        "toastify-js": "^1.12.0",
        "viewerjs": "^1.14.0",
        "winston": "^3.19.0",
        "winston-daily-rotate-file": "^5.0.0"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.10",
        "@inquirer/prompts": "^8.7.2",
        "@types/debug": "^4.1.13",
        "@types/express": "^5.0.6",
        "@types/fs-extra": "^11.0.4",
        "@types/less": "^3.0.8",
        "@types/md5": "^2.3.6",
        "@types/node": "^25.9.3",
        "@types/numeral": "^2.0.5",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/toastify-js": "^1.12.4",
        "baseline-browser-mapping": "^2.11.26",
        "chalk": "^6.0.0",
        "cross-env": "^10.1.0",
        "rollup-plugin-visualizer": "^7.1.1",
        "typescript": "^6.0.3",
        "vite-plugin-static-copy": "^4.1.1",
        "vitest": "^5.0.1"
    },
    "allowScripts": {
        "sharp@0.34.3": true,
        "esbuild@0.28.1": true
    }
}

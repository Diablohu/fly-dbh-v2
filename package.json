{
    "name": "fly-dbh-v2",
    "type": "module",
    "version": "0.0.1",
    "scripts": {
        "start": "node ./start.mjs",
        "dev": "astro dev --host --allowed-hosts local-dev.fly-dbh.com",
        "build": "astro build",
        "build:next": "cross-env FLYDBH_BUILD_MODE=next astro build --mode=next",
        "analyze": "cross-env FLYDBH_BUILD_MODE=analyze npm run build && npx --yes open-cli dist/client/stats.html",
        "preview": "astro preview --host --allowed-hosts local-dev.fly-dbh.com",
        "check": "astro check",
        "astro": "astro",
        "astro:upgrade": "npx @astrojs/upgrade",
        "test": "vitest",
        "up": "npm run astro:upgrade && npx npm-check-updates -i"
    },
    "dependencies": {
        "@astrojs/node": "^9.5.0",
        "@astrojs/react": "^4.4.0",
        "@astrojs/rss": "^4.0.13",
        "@microsoft/fetch-event-source": "^2.0.1",
        "@nanostores/react": "^1.0.0",
        "@oslojs/otp": "^1.1.0",
        "@react-oauth/google": "^0.12.2",
        "@sanity/client": "^7.12.0",
        "astro": "^5.15.1",
        "astro-portabletext": "^0.11.3",
        "axios": "^1.12.2",
        "cache-manager": "^7.2.4",
        "classnames": "^2.5.1",
        "colorthief": "^2.6.0",
        "dayjs": "^1.11.18",
        "debug": "^4.4.3",
        "dotenv": "^17.2.3",
        "fs-extra": "^11.3.2",
        "history": "^5.3.0",
        "isomorphic-dompurify": "^2.30.1",
        "less": "^4.4.2",
        "marked": "^16.4.1",
        "md5": "^2.3.0",
        "nanostores": "^1.0.1",
        "normalize.css": "^8.0.1",
        "numeral": "^2.0.6",
        "qrcode": "^1.5.4",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "react-dropzone": "^14.3.8",
        "react-inlinesvg": "^4.2.0",
        "react-is": "^19.1.1",
        "sanity": "^4.11.0",
        "styled-components": "^6.1.19",
        "toastify-js": "^1.12.0",
        "winston": "^3.18.3",
        "winston-daily-rotate-file": "^5.0.0"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.5",
        "@inquirer/prompts": "^7.9.0",
        "@types/express": "^5.0.3",
        "@types/fs-extra": "^11.0.4",
        "@types/md5": "^2.3.6",
        "@types/node": "^22.15.29",
        "@types/numeral": "^2.0.5",
        "@types/qrcode": "^1.5.5",
        "@types/react": "^19.2.2",
        "@types/react-dom": "^19.2.2",
        "@types/toastify-js": "^1.12.4",
        "cross-env": "^10.1.0",
        "npm-run-script": "^0.0.4",
        "rollup-plugin-visualizer": "^6.0.5",
        "typescript": "^5.9.3",
        "vitest": "^4.0.2"
    }
}
